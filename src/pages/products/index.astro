---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import "../../styles/commercial-page.css";

const products = (await getCollection("products", ({ data }) => data.locale === "en" && !data.draft))
	.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
	title="Products | Intent & Proof"
	description="Commercial acquisition systems built around intent, proof, conversion and measurement."
	lang="en"
	canonicalPath="/products/"
	alternates={[
		{ locale: "en", href: "/products/", isDefault: true },
		{ locale: "it", href: "/it/prodotti/" }
	]}
	noindex={true}
>
	<div class="commercial-page commercial-page--mint">
		<section class="commercial-section commercial-section--navy">
			<div class="commercial-shell">
				<header class="commercial-section-heading">
					<p class="commercial-eyebrow">Intent &amp; Proof products</p>
					<h1>Commercial systems designed to work together.</h1>
					<p>Each product solves a distinct acquisition problem while sharing the same evidence, publishing and measurement foundation.</p>
				</header>
			</div>
		</section>
		<section class="commercial-section commercial-section--neutral">
			<div class="commercial-shell commercial-card-grid" style="--commercial-columns:3">
				{products.map(({ data }) => (
					<article class="commercial-outcome-card">
						<span class="commercial-card-index">{String(data.order).padStart(2, "0")}</span>
						<h2>{data.productName}</h2>
						<p>{data.description}</p>
						<a class="commercial-button commercial-button--outline" href={`/products/${data.slug}/`}><span>Explore the system</span><i aria-hidden="true">↗</i></a>
					</article>
				))}
			</div>
		</section>
	</div>
</BaseLayout>
