---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ThankYouPage from "../../components/system/ThankYouPage.astro";
import { getGlobalSettings } from "../../lib/settings";

const settings = await getGlobalSettings();
const copy = settings.thankYou.en;
---

<BaseLayout
	title={`${copy.title} | Intent & Proof`}
	description={copy.text}
	lang="en"
	canonicalPath="/thank-you/"
	noindex={true}
	showRelatedContent={false}
>
	<ThankYouPage settings={settings} lang="en" />
</BaseLayout>
