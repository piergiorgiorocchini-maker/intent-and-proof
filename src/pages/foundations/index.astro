---
import FoundationHeader from "../../components/FoundationHeader.astro";
import FoundationPreviewLayout from "../../layouts/FoundationPreviewLayout.astro";
---

<FoundationPreviewLayout>
	<FoundationHeader />

	<main id="main-content">
		<section id="platform" class="fd-hero">
			<div class="fd-shell fd-hero__grid">
				<div class="fd-hero__copy">
					<p class="fd-eyebrow">
						<span></span>
						Customer acquisition &amp; commercial intelligence
					</p>
					<h1>Turn fragmented marketing into a measurable acquisition system.</h1>
					<p class="fd-hero__intro">
						Intent &amp; Proof connects demand, conversion, credible proof and measurement — giving service businesses a clearer path from market opportunity to qualified enquiry.
					</p>
					<div class="fd-hero__actions">
						<a class="fd-button fd-button--primary" href="/diagnostic/">
							Request a diagnostic
							<span aria-hidden="true">↗</span>
						</a>
						<a class="fd-button fd-button--secondary" href="#services">Explore the system</a>
					</div>
					<ul class="fd-hero__assurances" aria-label="Offer assurances">
						<li>Evidence before spend</li>
						<li>Built around your market</li>
						<li>Measured to real enquiries</li>
					</ul>
				</div>

				<div class="fd-console" aria-label="Acquisition diagnostic product preview">
					<div class="fd-console__halo"></div>
					<div class="fd-console__window">
						<div class="fd-console__top">
							<div>
								<span class="fd-console__mark" aria-hidden="true">I<span>&amp;</span>P</span>
								<div>
									<p>Acquisition Diagnostic</p>
									<small>Aurora Dental Group · Cagliari</small>
								</div>
							</div>
							<span class="fd-console__status"><i></i> Analysis ready</span>
						</div>

						<div class="fd-console__summary">
							<div class="fd-score">
								<div class="fd-score__ring">
									<span>72</span>
									<small>/100</small>
								</div>
								<div>
									<p>Foundation score</p>
									<strong>Promising, with two priority leaks</strong>
								</div>
							</div>
							<span class="fd-console__updated">Updated today</span>
						</div>

						<div class="fd-metrics">
							<div class="fd-metric">
								<div class="fd-metric__head"><span>Intent capture</span><strong>84</strong></div>
								<div class="fd-metric__bar"><i style="--metric-width: 84%; --metric-color: var(--fd-mint);"></i></div>
							</div>
							<div class="fd-metric">
								<div class="fd-metric__head"><span>Proof strength</span><strong>61</strong></div>
								<div class="fd-metric__bar"><i style="--metric-width: 61%; --metric-color: var(--fd-orange);"></i></div>
							</div>
							<div class="fd-metric">
								<div class="fd-metric__head"><span>Conversion path</span><strong>68</strong></div>
								<div class="fd-metric__bar"><i style="--metric-width: 68%; --metric-color: var(--fd-cobalt);"></i></div>
							</div>
							<div class="fd-metric">
								<div class="fd-metric__head"><span>Demand readiness</span><strong>79</strong></div>
								<div class="fd-metric__bar"><i style="--metric-width: 79%; --metric-color: var(--fd-mint);"></i></div>
							</div>
							<div class="fd-metric">
								<div class="fd-metric__head"><span>Measurement integrity</span><strong>48</strong></div>
								<div class="fd-metric__bar"><i style="--metric-width: 48%; --metric-color: var(--fd-orange);"></i></div>
							</div>
						</div>

						<div class="fd-next-action">
							<div class="fd-next-action__icon" aria-hidden="true">01</div>
							<div>
								<small>Next best action</small>
								<strong>Repair enquiry tracking before increasing campaign spend.</strong>
							</div>
							<span aria-hidden="true">→</span>
						</div>
					</div>

					<div class="fd-signal-card fd-signal-card--top">
						<span class="fd-signal-card__icon fd-signal-card__icon--blue" aria-hidden="true">↗</span>
						<div>
							<small>Demand signal</small>
							<strong>High-intent query rising</strong>
						</div>
					</div>
					<div class="fd-signal-card fd-signal-card--bottom">
						<span class="fd-signal-card__icon fd-signal-card__icon--green" aria-hidden="true">✓</span>
						<div>
							<small>Proof verified</small>
							<strong>2 case studies connected</strong>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="proof" class="fd-proof-strip" aria-label="Operating evidence">
			<div class="fd-shell fd-proof-strip__inner">
				<div class="fd-proof-strip__intro">
					<span>Built in live markets</span>
					<p>Operating evidence, not decorative claims.</p>
				</div>
				<div class="fd-proof-stat">
					<strong>2/2</strong>
					<span>first premium yacht enquiries converted</span>
				</div>
				<div class="fd-proof-stat">
					<strong>#2</strong>
					<span>priority local query in recent SERP data</span>
				</div>
				<div class="fd-proof-stat">
					<strong>100</strong>
					<span>mobile PageSpeed achieved on a live system</span>
				</div>
			</div>
		</section>

		<section id="services" class="fd-system">
			<div class="fd-shell">
				<div class="fd-section-heading">
					<div>
						<p class="fd-eyebrow fd-eyebrow--dark"><span></span>The operating system</p>
						<h2>Four disciplines. One commercial outcome.</h2>
					</div>
					<p>
						The visual system separates strategic layers without fragmenting the experience. Each module has its own job, proof and next action.
					</p>
				</div>

				<div class="fd-system-grid">
					<article class="fd-system-card fd-system-card--featured">
						<div class="fd-system-card__top">
							<span class="fd-module-number">01</span>
							<span class="fd-module-state">Entry point</span>
						</div>
						<div class="fd-module-icon fd-module-icon--diagnose" aria-hidden="true">
							<span></span><span></span><span></span>
						</div>
						<p class="fd-system-card__verb">Diagnose</p>
						<h3>Find the commercial leaks before prescribing more activity.</h3>
						<p>Intent, proof, conversion, demand readiness and measurement become one readable decision layer.</p>
						<a href="/diagnostic/">Acquisition Diagnostic <span aria-hidden="true">→</span></a>
					</article>

					<article class="fd-system-card">
						<div class="fd-system-card__top">
							<span class="fd-module-number">02</span>
							<span class="fd-module-state">Foundation</span>
						</div>
						<div class="fd-module-icon fd-module-icon--build" aria-hidden="true">
							<span></span><span></span><span></span><span></span>
						</div>
						<p class="fd-system-card__verb">Build</p>
						<h3>Create the conversion foundation.</h3>
						<p>Positioning, website, landing pages, proof and contact paths built as a coherent system.</p>
						<a href="#account">Conversion Foundation <span aria-hidden="true">→</span></a>
					</article>

					<article class="fd-system-card">
						<div class="fd-system-card__top">
							<span class="fd-module-number">03</span>
							<span class="fd-module-state">Demand</span>
						</div>
						<div class="fd-module-icon fd-module-icon--capture" aria-hidden="true">
							<span></span><span></span><span></span>
						</div>
						<p class="fd-system-card__verb">Capture</p>
						<h3>Meet buyers where intent already exists.</h3>
						<p>Search, local visibility, durable content and paid demand connected to the right destination.</p>
						<a href="#account">Demand Capture <span aria-hidden="true">→</span></a>
					</article>

					<article class="fd-system-card">
						<div class="fd-system-card__top">
							<span class="fd-module-number">04</span>
							<span class="fd-module-state">Learning</span>
						</div>
						<div class="fd-module-icon fd-module-icon--measure" aria-hidden="true">
							<span></span><span></span><span></span><span></span>
						</div>
						<p class="fd-system-card__verb">Measure</p>
						<h3>Turn outcomes into better decisions.</h3>
						<p>Track useful actions, qualify leads and improve the components that influence revenue.</p>
						<a href="#account">Measurement &amp; Growth <span aria-hidden="true">→</span></a>
					</article>
				</div>
			</div>
		</section>

		<section class="fd-engines">
			<div class="fd-shell">
				<div class="fd-engines__heading">
					<p class="fd-eyebrow fd-eyebrow--light"><span></span>Future-ready architecture</p>
					<h2>One foundation. Two growth engines.</h2>
					<p>
						The public site remains simple while the product layer can expand into inbound acquisition and account intelligence without rebuilding the brand.
					</p>
				</div>

				<div class="fd-engine-map">
					<article class="fd-engine-card">
						<div class="fd-engine-card__label">
							<span>Engine 01</span>
							<strong>Available first</strong>
						</div>
						<h3>Inbound Acquisition</h3>
						<p>Turn active demand into measurable enquiries.</p>
						<ol>
							<li><span>01</span>Intent</li>
							<li><span>02</span>Proof</li>
							<li><span>03</span>Action</li>
							<li><span>04</span>Measurement</li>
						</ol>
					</article>

					<div class="fd-shared-core">
						<div class="fd-shared-core__orb">
							<span>I<span>&amp;</span>P</span>
						</div>
						<strong>Shared intelligence layer</strong>
						<p>Account · Evidence · Scoring · Tracking · Learning</p>
					</div>

					<article class="fd-engine-card fd-engine-card--future">
						<div class="fd-engine-card__label">
							<span>Engine 02</span>
							<strong>Future module</strong>
						</div>
						<h3>Account Intelligence</h3>
						<p>Find the right companies, buyers and commercial moment.</p>
						<ol>
							<li><span>01</span>Market</li>
							<li><span>02</span>Account</li>
							<li><span>03</span>Reason</li>
							<li><span>04</span>Outreach</li>
						</ol>
					</article>
				</div>
			</div>
		</section>

		<section id="solutions" class="fd-solutions">
			<div class="fd-shell">
				<div class="fd-section-heading">
					<div>
						<p class="fd-eyebrow fd-eyebrow--dark"><span></span>Guided by market context</p>
						<h2>Different markets. The same decision discipline.</h2>
					</div>
					<p>
						Solution pages should change the evidence, language and workflow — not merely swap a sector name inside the same generic template.
					</p>
				</div>

				<div class="fd-solution-grid">
					<article class="fd-solution-card fd-solution-card--local">
						<span class="fd-solution-card__index">01</span>
						<div class="fd-solution-card__visual" aria-hidden="true">
							<div class="fd-map-pin"></div>
							<span></span><span></span><span></span>
						</div>
						<p>Local service businesses</p>
						<h3>Own the highest-value demand in the right territory.</h3>
						<a href="#account">Explore solution <span aria-hidden="true">→</span></a>
					</article>

					<article class="fd-solution-card fd-solution-card--premium">
						<span class="fd-solution-card__index">02</span>
						<div class="fd-solution-card__visual" aria-hidden="true">
							<div class="fd-premium-signal"></div>
						</div>
						<p>High-value specialist services</p>
						<h3>Make expertise visible before price enters the conversation.</h3>
						<a href="#account">Explore solution <span aria-hidden="true">→</span></a>
					</article>

					<article class="fd-solution-card fd-solution-card--b2b">
						<span class="fd-solution-card__index">03</span>
						<div class="fd-solution-card__visual" aria-hidden="true">
							<div class="fd-node fd-node--one"></div>
							<div class="fd-node fd-node--two"></div>
							<div class="fd-node fd-node--three"></div>
							<div class="fd-node fd-node--four"></div>
						</div>
						<p>B2B growth teams</p>
						<h3>Prioritise accounts with a documented reason to engage.</h3>
						<a href="#account">Explore solution <span aria-hidden="true">→</span></a>
					</article>
				</div>
			</div>
		</section>

		<section id="account" class="fd-account">
			<div class="fd-shell fd-account__grid">
				<div class="fd-account__copy">
					<p class="fd-eyebrow fd-eyebrow--dark"><span></span>Progressive product access</p>
					<h2>The header grows when the product becomes real.</h2>
					<p>
						Login, language and free signup appear in this concept because the underlying structure anticipates them. They should reach the public Home only when each action has a useful destination.
					</p>
					<div class="fd-account__levels">
						<div>
							<span>01</span>
							<p><strong>Anonymous visitor</strong> gets one credible result.</p>
						</div>
						<div>
							<span>02</span>
							<p><strong>Free account</strong> saves reports and receives starter credits.</p>
						</div>
						<div>
							<span>03</span>
							<p><strong>Client workspace</strong> connects projects, actions and outcomes.</p>
						</div>
					</div>
				</div>

				<div class="fd-workspace">
					<div class="fd-workspace__sidebar">
						<span class="fd-workspace__logo">I<span>&amp;</span>P</span>
						<nav aria-label="Workspace preview">
							<a class="is-active" href="#account"><i></i>Overview</a>
							<a href="#account"><i></i>Diagnostics</a>
							<a href="#account"><i></i>Projects</a>
							<a href="#account"><i></i>Signals</a>
							<a href="#account"><i></i>Reports</a>
						</nav>
						<div class="fd-workspace__credits">
							<small>Starter credits</small>
							<strong>8 / 10</strong>
							<span><i></i></span>
						</div>
					</div>
					<div class="fd-workspace__main">
						<div class="fd-workspace__title">
							<div>
								<small>Good morning, Pier</small>
								<h3>Acquisition overview</h3>
							</div>
							<span class="fd-avatar">PR</span>
						</div>
						<div class="fd-workspace__stats">
							<div><small>Projects</small><strong>03</strong><span>2 active</span></div>
							<div><small>Diagnostics</small><strong>07</strong><span>+2 this month</span></div>
							<div><small>Priority actions</small><strong>04</strong><span>1 due now</span></div>
						</div>
						<div class="fd-workspace__chart">
							<div class="fd-workspace__chart-head">
								<div><small>Qualified enquiries</small><strong>28</strong></div>
								<span>Last 90 days⌄</span>
							</div>
							<svg viewBox="0 0 520 150" role="img" aria-label="Illustrative upward enquiry trend">
								<defs>
									<linearGradient id="fdChartFill" x1="0" x2="0" y1="0" y2="1">
										<stop offset="0%" stop-color="#4a63ff" stop-opacity=".22" />
										<stop offset="100%" stop-color="#4a63ff" stop-opacity="0" />
									</linearGradient>
								</defs>
								<path class="fd-chart-fill" d="M0 125 C45 118, 55 94, 104 101 S176 112, 212 76 S272 62, 315 73 S390 50, 426 47 S475 31, 520 18 L520 150 L0 150 Z" />
								<path class="fd-chart-line" d="M0 125 C45 118, 55 94, 104 101 S176 112, 212 76 S272 62, 315 73 S390 50, 426 47 S475 31, 520 18" />
								<circle cx="520" cy="18" r="5" />
							</svg>
						</div>
					</div>
				</div>
			</div>
		</section>

		<section id="resources" class="fd-research">
			<div class="fd-shell fd-research__grid">
				<div class="fd-research__copy">
					<p class="fd-eyebrow fd-eyebrow--light"><span></span>Research remains a distinct system</p>
					<h2>Authority attracts demand. Product turns it into learning.</h2>
					<p>
						The current Backlinko-inspired article structure remains appropriate for pillars, studies and SEO. It should live beside this platform system, not be forced to perform the same job.
					</p>
					<a class="fd-text-link" href="/blog/">Explore research <span aria-hidden="true">→</span></a>
				</div>

				<a class="fd-research-card" href="/blog/local-service-lead-generation/">
					<div class="fd-research-card__meta">
						<span>Field guide 01</span>
						<small>12 min read</small>
					</div>
					<div class="fd-research-card__graphic" aria-hidden="true">
						<div class="fd-research-card__path">
							<span>Intent</span><i></i><span>Proof</span><i></i><span>Action</span>
						</div>
					</div>
					<p>Local service acquisition</p>
					<h3>A practical system for turning search demand into measurable leads.</h3>
					<span class="fd-research-card__link">Read the field guide <i aria-hidden="true">→</i></span>
				</a>
			</div>
		</section>

		<section id="visual-system" class="fd-visual-system">
			<div class="fd-shell">
				<div class="fd-visual-system__heading">
					<div>
						<p class="fd-eyebrow fd-eyebrow--dark"><span></span>Visual foundation</p>
						<h2>Colour has a job, not merely a mood.</h2>
					</div>
					<p>Every colour is assigned to a stable product meaning and an accessible contrast role.</p>
				</div>

				<div class="fd-colour-grid">
					<div class="fd-colour-card fd-colour-card--navy">
						<span>#071C2C</span>
						<strong>Foundation Navy</strong>
						<small>Authority · structure · primary action</small>
					</div>
					<div class="fd-colour-card fd-colour-card--mint">
						<span>#43C59E</span>
						<strong>Proof Mint</strong>
						<small>Verified · positive · brand signature</small>
					</div>
					<div class="fd-colour-card fd-colour-card--orange">
						<span>#FF6B3D</span>
						<strong>Action Orange</strong>
						<small>Priority · friction · commercial signal</small>
					</div>
					<div class="fd-colour-card fd-colour-card--cobalt">
						<span>#4A63FF</span>
						<strong>Intelligence Cobalt</strong>
						<small>Data · product · active insight</small>
					</div>
					<div class="fd-colour-card fd-colour-card--surface">
						<span>#F6F8FB</span>
						<strong>Evidence Surface</strong>
						<small>Reading · hierarchy · interface depth</small>
					</div>
				</div>

				<div class="fd-type-system">
					<div>
						<span>Display · Manrope Variable</span>
						<strong>Clear enough for decisions. Distinct enough to own.</strong>
					</div>
					<div>
						<span>Interface &amp; body · Inter Variable</span>
						<p>Stable metrics, controlled spacing and readable product interfaces across Safari, Chrome and mobile.</p>
					</div>
				</div>
			</div>
		</section>

		<section class="fd-final-cta">
			<div class="fd-shell fd-final-cta__inner">
				<div>
					<p class="fd-eyebrow fd-eyebrow--light"><span></span>Foundation preview v0.1</p>
					<h2>A stronger visual system, ready to grow into the product.</h2>
				</div>
				<a class="fd-button fd-button--orange" href="/diagnostic/">Request a diagnostic <span aria-hidden="true">↗</span></a>
			</div>
		</section>
	</main>

	<footer class="fd-footer">
		<div class="fd-shell fd-footer__inner">
			<a class="fd-brand fd-brand--footer" href="/">
				<span class="fd-brand__symbol" aria-hidden="true">I<span>&amp;</span>P</span>
				<span class="fd-brand__name">INTENT<span>&amp; PROOF</span></span>
			</a>
			<p>Customer acquisition systems built around intent, evidence and measurable outcomes.</p>
			<span>Private design preview · Not indexed</span>
		</div>
	</footer>
</FoundationPreviewLayout>
