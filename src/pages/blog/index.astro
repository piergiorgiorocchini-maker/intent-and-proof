---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ArchiveHero from "../../components/content/ArchiveHero.astro";
import ArticleGrid from "../../components/content/ArticleGrid.astro";
import CategoryNav from "../../components/content/CategoryNav.astro";
import { getPublishedArticleIndex } from "../../lib/content/interlinking";
import "../../styles/content-archives.css";

const articles = await getPublishedArticleIndex("en");
const categoryEntries = (await getCollection("categories"))
	.filter((entry) => entry.data.locale === "en")
	.sort((a, b) => a.data.order - b.data.order);
const categories = categoryEntries.map((entry) => ({
	name: entry.data.name,
	slug: entry.data.slug,
	description: entry.data.description,
	locale: "en" as const
}));
---

<BaseLayout
	title="Research & Growth Guides | Intent & Proof"
	description="Research on local SEO, conversion, paid acquisition, proof and measurement for service businesses."
	lang="en"
	canonicalPath="/blog/"
	showRelatedContent={false}
>
	<ArchiveHero
		eyebrow="Intent & Proof Research"
		title="Systems, evidence and practical growth research."
		description="Structured guides for building customer acquisition assets that connect market intent, credible proof, conversion and measurement."
		meta={`${articles.length} published ${articles.length === 1 ? "article" : "articles"}`}
		breadcrumbs={[{ label: "Home", href: "/" }]}
	/>
	<CategoryNav categories={categories} locale="en" />
	<ArticleGrid
		articles={articles}
		title="Latest research"
		description="The newest published articles across every active category."
		emptyText="The archive is ready. Published research will appear here automatically."
	/>
</BaseLayout>
