---
import "@fontsource-variable/inter";
import "@fontsource-variable/manrope";
import FoundationHeader from "../components/FoundationHeader.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/foundations.css";

const {
	title = "Intent & Proof",
	description = "Measurable customer acquisition systems for service businesses.",
	image = "",
	ogType = "website",
	publishedDate = "",
	updatedDate = "",
	author = "",
	noindex = false,
	structuredData = null
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://www.intentandproof.com");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const socialImage = image ? new URL(image, siteURL) : null;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#071c2c" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalURL} />

		<meta property="og:site_name" content="Intent & Proof" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		{socialImage && <meta property="og:image" content={socialImage} />}
		{publishedDate && <meta property="article:published_time" content={publishedDate} />}
		{updatedDate && <meta property="article:modified_time" content={updatedDate} />}
		{author && <meta property="article:author" content={author} />}

		<meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		<meta name="generator" content={Astro.generator} />

		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body class="fd-body">
		<a class="fd-skip-link" href="#main-content">Skip to content</a>
		<FoundationHeader />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
