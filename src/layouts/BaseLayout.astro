---
import "@fontsource-variable/inter";
import "@fontsource-variable/manrope";
import FoundationHeader from "../components/FoundationHeader.astro";
import Footer from "../components/Footer.astro";
import "../styles/global.css";
import "../styles/foundations.css";

interface AlternateLocale {
	locale: string;
	href: string;
	isDefault?: boolean;
}

const {
	title = "Intent & Proof",
	description = "Measurable customer acquisition systems for service businesses.",
	image = "",
	ogType = "website",
	publishedDate = "",
	updatedDate = "",
	author = "",
	lang = "en",
	dir = "ltr",
	canonicalPath = "",
	alternates = [] as AlternateLocale[],
	noindex = false,
	nofollow = false,
	skipLinkLabel = lang === "it" ? "Vai al contenuto" : "Skip to content",
	structuredData = null
} = Astro.props;

const siteURL = Astro.site ?? new URL("https://www.intentandproof.com");
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, siteURL);
const socialImage = image ? new URL(image, siteURL) : null;
const robotsDirectives = [noindex ? "noindex" : "index", nofollow ? "nofollow" : "follow"].join(", ");
---

<!doctype html>
<html lang={lang} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#071c2c" />
		<meta name="robots" content={robotsDirectives} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<link rel="canonical" href={canonicalURL} />
		{
			alternates.map((alternate: AlternateLocale) => (
				<link
					rel="alternate"
					hreflang={alternate.isDefault ? "x-default" : alternate.locale}
					href={new URL(alternate.href, siteURL)}
				/>
			))
		}

		<meta property="og:site_name" content="Intent & Proof" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content={lang === "it" ? "it_IT" : "en_GB"} />
		{socialImage && <meta property="og:image" content={socialImage} />}
		{publishedDate && <meta property="article:published_time" content={publishedDate} />}
		{updatedDate && <meta property="article:modified_time" content={updatedDate} />}
		{author && <meta property="article:author" content={author} />}

		<meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		<meta name="generator" content={Astro.generator} />

		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body class="fd-body">
		<a class="fd-skip-link" href="#main-content">{skipLinkLabel}</a>
		<FoundationHeader />
		<main id="main-content">
			<slot />
		</main>
		<Footer />
	</body>
</html>
