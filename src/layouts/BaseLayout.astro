---
import { getCollection } from "astro:content";
import "@fontsource-variable/inter";
import "@fontsource-variable/manrope";
import FoundationHeader from "../components/FoundationHeader.astro";
import Footer from "../components/Footer.astro";
import HomepageResearchCardImages from "../components/content/HomepageResearchCardImages.astro";
import LatestArticles from "../components/content/LatestArticles.astro";
import InformationalTrackingNotice from "../components/system/InformationalTrackingNotice.astro";
import TrackingManager from "../components/system/TrackingManager.astro";
import TrackingRuntime from "../components/system/TrackingRuntime.astro";
import { buildContentAlternates } from "../lib/i18n/alternates";
import {
	localeMetadata,
	publishedLocales,
	resolvePublishedLocale,
	uiCopy,
	type PublishedLocale
} from "../lib/i18n/ui";
import { getGlobalSettings } from "../lib/settings";
import "../styles/global.css";
import "../styles/foundations.css";
import "../styles/home-refinement.css";
import "../styles/brand-icons.css";
import "../styles/homepage-route.css";
import "../styles/content-discovery.css";
import "../styles/system-controls.css";

interface AlternateLocale {
	locale: string;
	href: string;
	isDefault?: boolean;
}

interface RelatedContentOptions {
	eyebrow?: string;
	title?: string;
	text?: string;
	currentId?: string;
	currentHref?: string;
	categoryIds?: string[];
	tags?: string[];
	manualArticleIds?: string[];
	limit?: number;
	fallbackToLatest?: boolean;
	allHref?: string;
	allLabel?: string;
	compact?: boolean;
}

const rawLang = Astro.props.lang || "en";
const contentLocale = resolvePublishedLocale(rawLang);
const copy = uiCopy[contentLocale];

const {
	title = "Intent & Proof",
	description = "Measurable customer acquisition systems for service businesses.",
	image = "",
	ogType = "website",
	publishedDate = "",
	updatedDate = "",
	author = "",
	dir = "ltr",
	canonicalPath = "",
	alternates = [] as AlternateLocale[],
	noindex = false,
	nofollow = false,
	skipLinkLabel = copy.base.skipLink,
	structuredData = null,
	showRelatedContent = true,
	relatedContent = {} as RelatedContentOptions
} = Astro.props;

const settings = await getGlobalSettings();
const siteURL = Astro.site ?? new URL(settings.site.baseUrl);
const canonicalURL = new URL(canonicalPath || Astro.url.pathname, siteURL);
const socialImage = image ? new URL(image, siteURL) : null;
const robotsDirectives = [noindex ? "noindex" : "index", nofollow ? "nofollow" : "follow"].join(", ");

let resolvedAlternates = alternates as AlternateLocale[];
const articleRoute = Astro.url.pathname.match(/^\/(?:it\/)?blog\/([^/]+)\/?$/);

if (resolvedAlternates.length === 0 && articleRoute) {
	const articleSlug = articleRoute[1];
	const articles = await getCollection("articles");
	const currentArticle = articles.find(
		(article) => article.data.locale === contentLocale
			&& article.data.slug === articleSlug
			&& article.data.draft !== true
	);

	if (currentArticle) {
		resolvedAlternates = buildContentAlternates(
			articles,
			currentArticle.data.translationKey,
			"article"
		);
	}
}

const languageLinks = publishedLocales.map((locale: PublishedLocale) => {
	const exactAlternate = resolvedAlternates.find(
		(alternate: AlternateLocale) => !alternate.isDefault && alternate.locale === locale
	);
	return {
		locale,
		label: localeMetadata[locale].name,
		href: locale === contentLocale
			? Astro.url.pathname
			: exactAlternate?.href || uiCopy[locale].routes.home,
		current: locale === contentLocale
	};
});

const gtmId = settings.tracking.enabled
	&& settings.tracking.delivery === "gtm"
	&& settings.tracking.googleTagManager.enabled
	? settings.tracking.googleTagManager.containerId
	: "";
---

<!doctype html>
<html lang={contentLocale} dir={dir}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#071c2c" />
		<meta name="robots" content={robotsDirectives} />
		<TrackingManager settings={settings} lang={contentLocale} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="mask-icon" href="/favicon.svg?v=2" color="#16856D" />
		<link rel="canonical" href={canonicalURL} />
		{
			resolvedAlternates.map((alternate: AlternateLocale) => (
				<link
					rel="alternate"
					hreflang={alternate.isDefault ? "x-default" : alternate.locale}
					href={new URL(alternate.href, siteURL)}
				/>
			))
		}

		<meta property="og:site_name" content="Intent & Proof" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:locale" content={localeMetadata[contentLocale].og} />
		{socialImage && <meta property="og:image" content={socialImage} />}
		{publishedDate && <meta property="article:published_time" content={publishedDate} />}
		{updatedDate && <meta property="article:modified_time" content={updatedDate} />}
		{author && <meta property="article:author" content={author} />}

		<meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <meta name="twitter:image" content={socialImage} />}
		<meta name="generator" content={Astro.generator} />

		{structuredData && (
			<script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
		)}
		<HomepageResearchCardImages />
		<slot name="head" />
		<title>{title}</title>
	</head>
	<body class="fd-body">
		{gtmId && (
			<noscript>
				<iframe
					src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
					height="0"
					width="0"
					style="display:none;visibility:hidden"
					title="Google Tag Manager"
				></iframe>
			</noscript>
		)}
		<a class="fd-skip-link" href="#main-content">{skipLinkLabel}</a>
		<FoundationHeader lang={contentLocale} languageLinks={languageLinks} />
		<main id="main-content">
			<slot />
			{
				showRelatedContent && (
					<LatestArticles
						locale={contentLocale}
						eyebrow={relatedContent.eyebrow}
						title={relatedContent.title}
						text={relatedContent.text}
						currentId={relatedContent.currentId}
						currentHref={relatedContent.currentHref || Astro.url.pathname}
						categoryIds={relatedContent.categoryIds}
						tags={relatedContent.tags}
						manualArticleIds={relatedContent.manualArticleIds}
						limit={relatedContent.limit}
						fallbackToLatest={relatedContent.fallbackToLatest}
						allHref={relatedContent.allHref}
						allLabel={relatedContent.allLabel}
						compact={relatedContent.compact}
					/>
				)
			}
		</main>
		<Footer lang={contentLocale} />
		<InformationalTrackingNotice settings={settings} lang={contentLocale} />
		<TrackingRuntime settings={settings} />
	</body>
</html>