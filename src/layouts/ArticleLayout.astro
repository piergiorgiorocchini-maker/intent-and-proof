---
import BaseLayout from "./BaseLayout.astro";
import ArticleFooter from "../components/editorial/ArticleFooter.astro";
import ArticleHero from "../components/editorial/ArticleHero.astro";
import GiscusComments from "../components/editorial/GiscusComments.astro";
import ShareBar from "../components/editorial/ShareBar.astro";
import SidebarCta from "../components/editorial/SidebarCta.astro";
import TableOfContents from "../components/editorial/TableOfContents.astro";
import { editorialComponents } from "../components/editorial/registry";
import { resolvePublishedLocale, uiCopy } from "../lib/i18n/ui";
import "../styles/article-editorial.css";
import "../styles/article-hero-split.css";
import "../styles/editorial-components.css";

const contentLocale = resolvePublishedLocale(Astro.props.locale);
const copy = uiCopy[contentLocale];
const articleCopy = copy.article;

const {
	title = articleCopy.defaultTitle,
	description = articleCopy.defaultDescription,
	seoTitle = title,
	seoDescription = description,
	eyebrow = articleCopy.defaultEyebrow,
	categoryHref = copy.routes.blog,
	author = "Piergiorgio Rocchini",
	authorHref = contentLocale === "it" ? "/it/autori/piergiorgio-rocchini/" : "/authors/piergiorgio-rocchini/",
	authorImageSrc = "",
	authorImageAlt = "",
	authorRole = articleCopy.defaultAuthorRole,
	authorBio = articleCopy.defaultAuthorBio,
	editor = "",
	editorHref = "",
	editorImageSrc = "",
	editorImageAlt = "",
	publishedDate = "2026-07-01",
	updatedDate = "2026-07-01",
	readTime = contentLocale === "it" ? "8 min di lettura" : "8 min read",
	imageSrc = "",
	imageAlt = articleCopy.defaultImageAlt,
	heroImageSrc = imageSrc,
	heroImageAlt = imageAlt,
	heroImagePosition = "center",
	heroLayout = "split",
	heroTone = "aurora",
	showDescription = true,
	videoUrl = "",
	ctaEyebrow = articleCopy.ctaEyebrow,
	ctaTitle = articleCopy.ctaTitle,
	ctaText = articleCopy.ctaText,
	ctaLabel = articleCopy.ctaLabel,
	ctaHref = copy.routes.diagnostic,
	sidebarEyebrow = articleCopy.sidebarEyebrow,
	sidebarTitle = articleCopy.sidebarTitle,
	sidebarText = articleCopy.sidebarText,
	sidebarLabel = articleCopy.sidebarLabel,
	sidebarHref = copy.routes.diagnostic,
	showToc = true,
	showShare = true,
	showSidebarCta = true,
	showComments = false,
	commentsRepo = "",
	commentsRepoId = "",
	commentsCategory = "General",
	commentsCategoryId = "",
	commentsMapping = "pathname",
	commentsTheme = "preferred_color_scheme",
	commentsLang = contentLocale,
	layoutVariant = "wide",
	canonicalPath = "",
	noindex = false,
	nofollow = false,
	articleId = "",
	showRelatedContent = true,
	relatedCategoryIds = [],
	relatedTags = [],
	relatedManualArticleIds = [],
	relatedContentLimit = 4,
	relatedContentTitle = "",
	relatedContentText = "",
	breadcrumbs = articleCopy.breadcrumbs,
	tags = [],
	toc = articleCopy.toc
} = Astro.props;

const resolvedAuthorImageAlt = authorImageAlt || `${author} ${articleCopy.portraitSuffix}`;
const resolvedEditorImageAlt = editorImageAlt || `${editor} ${articleCopy.portraitSuffix}`;
const siteURL = Astro.site ?? new URL("https://www.intentandproof.com");
const articleURL = new URL(Astro.url.pathname, siteURL);
const articleImage = heroImageSrc ? new URL(heroImageSrc, siteURL).toString() : undefined;
const editorialComponentCount = Object.keys(editorialComponents).length;
const resolvedRelatedTags = relatedTags.length > 0
	? relatedTags
	: tags.map((tag) => typeof tag === "string" ? tag : tag.label).filter(Boolean);

const articleSchema = {
	"@type": "Article",
	headline: title,
	description,
	mainEntityOfPage: articleURL.toString(),
	datePublished: publishedDate,
	dateModified: updatedDate,
	author: {
		"@type": "Person",
		name: author,
		url: new URL(authorHref, siteURL).toString()
	},
	...(editor ? {
		editor: {
			"@type": "Person",
			name: editor,
			...(editorHref ? { url: new URL(editorHref, siteURL).toString() } : {})
		}
	} : {}),
	publisher: {
		"@type": "Organization",
		name: "Intent & Proof",
		url: siteURL.toString()
	},
	...(articleImage ? { image: articleImage } : {})
};

const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	itemListElement: [
		...breadcrumbs.map((item, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: item.label,
			item: new URL(item.href, siteURL).toString()
		})),
		{
			"@type": "ListItem",
			position: breadcrumbs.length + 1,
			name: title,
			item: articleURL.toString()
		}
	]
};

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [articleSchema, breadcrumbSchema]
};
---

<BaseLayout
	title={seoTitle}
	description={seoDescription}
	image={heroImageSrc}
	ogType="article"
	publishedDate={publishedDate}
	updatedDate={updatedDate}
	author={author}
	lang={contentLocale}
	canonicalPath={canonicalPath}
	noindex={noindex}
	nofollow={nofollow}
	structuredData={structuredData}
	showRelatedContent={showRelatedContent}
	relatedContent={{
		currentId: articleId,
		currentHref: Astro.url.pathname,
		categoryIds: relatedCategoryIds,
		tags: resolvedRelatedTags,
		manualArticleIds: relatedManualArticleIds,
		limit: relatedContentLimit,
		title: relatedContentTitle || articleCopy.relatedTopicTitle,
		text: relatedContentText || articleCopy.relatedTopicText,
		allHref: copy.routes.blog,
		allLabel: articleCopy.relatedAll
	}}
>
	<article class={`article-shell article-shell--${layoutVariant}${showSidebarCta ? " article-shell--has-mobile-cta" : ""}`} data-editorial-components={editorialComponentCount}>
		<ArticleHero
			title={title}
			description={description}
			eyebrow={eyebrow}
			categoryHref={categoryHref}
			breadcrumbs={breadcrumbs}
			tags={tags}
			publishedDate={publishedDate}
			updatedDate={updatedDate}
			readTime={readTime}
			author={author}
			authorHref={authorHref}
			authorRole={authorRole}
			authorImageSrc={authorImageSrc}
			authorImageAlt={resolvedAuthorImageAlt}
			editor={editor}
			editorHref={editorHref}
			editorImageSrc={editorImageSrc}
			editorImageAlt={resolvedEditorImageAlt}
			heroImageSrc={heroImageSrc}
			heroImageAlt={heroImageAlt}
			heroImagePosition={heroImagePosition}
			heroLayout={heroLayout}
			heroTone={heroTone}
			showDescription={showDescription}
			videoUrl={videoUrl}
			locale={contentLocale}
		/>

		{
			showSidebarCta && (
				<aside class="article-mobile-cta" data-mobile-article-cta aria-label={articleCopy.mobileAction}>
					<div>
						{sidebarEyebrow && <span>{sidebarEyebrow}</span>}
						<strong>{sidebarTitle}</strong>
					</div>
					<a href={sidebarHref}>{sidebarLabel}</a>
				</aside>
			)
		}

		<div class="article-editorial-frame">
			<aside class="article-left-rail" aria-label={articleCopy.navigation}>
				{showToc && <TableOfContents items={toc} />}
			</aside>

			<div class="article-content"><slot /></div>

			{
				(showSidebarCta || showShare) && (
					<aside class="article-right-rail" aria-label={articleCopy.actionAndSharing}>
						{showSidebarCta && (
							<SidebarCta
								eyebrow={sidebarEyebrow}
								title={sidebarTitle}
								text={sidebarText}
								label={sidebarLabel}
								href={sidebarHref}
							/>
						)}
						{showShare && <ShareBar title={title} url={articleURL.toString()} locale={contentLocale} />}
					</aside>
				)
			}
		</div>

		<ArticleFooter
			author={author}
			authorHref={authorHref}
			authorBio={authorBio}
			authorImageSrc={authorImageSrc}
			authorImageAlt={resolvedAuthorImageAlt}
			ctaEyebrow={ctaEyebrow}
			ctaTitle={ctaTitle}
			ctaText={ctaText}
			ctaLabel={ctaLabel}
			ctaHref={ctaHref}
		>
			{
				showComments && commentsRepo && commentsRepoId && commentsCategoryId && (
					<GiscusComments
						repo={commentsRepo}
						repoId={commentsRepoId}
						category={commentsCategory}
						categoryId={commentsCategoryId}
						mapping={commentsMapping}
						theme={commentsTheme}
						lang={commentsLang}
					/>
				)
			}
		</ArticleFooter>
	</article>
</BaseLayout>

<script>
	const mobileCta = document.querySelector<HTMLElement>("[data-mobile-article-cta]");
	const finalCta = document.querySelector<HTMLElement>(".article-bottom-cta");

	if (mobileCta && finalCta && "IntersectionObserver" in window) {
		const observer = new IntersectionObserver(
			([entry]) => mobileCta.classList.toggle("is-hidden", entry.isIntersecting),
			{ threshold: 0.08 }
		);

		observer.observe(finalCta);
	}
</script>

<style>
	.article-right-rail {
		display: grid;
		gap: 18px;
	}

	.article-mobile-cta {
		display: none;
	}

	@media (max-width: 900px) {
		.article-shell--has-mobile-cta {
			padding-bottom: 104px;
		}

		.article-mobile-cta {
			position: fixed;
			z-index: 80;
			left: 14px;
			right: 14px;
			bottom: max(12px, env(safe-area-inset-bottom));
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 14px;
			padding: 12px 12px 12px 16px;
			border: 1px solid rgba(255, 255, 255, 0.14);
			border-radius: 18px;
			background: rgba(7, 28, 44, 0.97);
			box-shadow: 0 18px 48px rgba(5, 8, 22, 0.3);
			color: #ffffff;
			transition: opacity 180ms ease, transform 180ms ease;
			backdrop-filter: blur(14px);
		}

		.article-mobile-cta.is-hidden {
			opacity: 0;
			pointer-events: none;
			transform: translateY(calc(100% + 28px));
		}

		.article-mobile-cta > div {
			display: grid;
			gap: 3px;
			min-width: 0;
		}

		.article-mobile-cta span {
			color: #59d8b2;
			font-size: 0.62rem;
			font-weight: 850;
			letter-spacing: 0.1em;
			text-transform: uppercase;
		}

		.article-mobile-cta strong {
			display: -webkit-box;
			overflow: hidden;
			color: #ffffff;
			font-size: 0.82rem;
			line-height: 1.22;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
		}

		.article-mobile-cta a {
			display: inline-flex;
			flex: 0 0 auto;
			min-height: 44px;
			max-width: 44%;
			padding: 0 15px;
			align-items: center;
			justify-content: center;
			border-radius: 999px;
			background: #ff6b3d;
			color: #ffffff;
			font-size: 0.78rem;
			font-weight: 850;
			line-height: 1.15;
			text-align: center;
			text-decoration: none;
		}
	}

	@media (max-width: 430px) {
		.article-mobile-cta {
			left: 10px;
			right: 10px;
			gap: 10px;
			padding-left: 13px;
		}

		.article-mobile-cta strong {
			font-size: 0.76rem;
		}

		.article-mobile-cta a {
			max-width: 46%;
			padding-inline: 12px;
			font-size: 0.74rem;
		}
	}
</style>