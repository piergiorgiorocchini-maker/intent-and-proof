---
import BaseLayout from "./BaseLayout.astro";
import ArticleFooter from "../components/editorial/ArticleFooter.astro";
import ArticleHero from "../components/editorial/ArticleHero.astro";
import GiscusComments from "../components/editorial/GiscusComments.astro";
import ShareBar from "../components/editorial/ShareBar.astro";
import SidebarCta from "../components/editorial/SidebarCta.astro";
import TableOfContents from "../components/editorial/TableOfContents.astro";
import { editorialComponents } from "../components/editorial/registry";
import "../styles/article-editorial.css";
import "../styles/article-hero-split.css";
import "../styles/editorial-components.css";

const {
	title = "Intent & Proof Growth Guide",
	description = "Practical growth systems for service businesses.",
	eyebrow = "Growth Guide",
	categoryHref = "/blog/",
	author = "Piergiorgio Rocchini",
	authorHref = "/authors/piergiorgio-rocchini/",
	authorImageSrc = "",
	authorImageAlt = "",
	authorRole = "Founder, analyst and acquisition-system operator",
	authorBio = "Piergiorgio Rocchini combines financial analysis, market research and hands-on customer acquisition systems built in live service markets.",
	editor = "",
	editorHref = "",
	editorImageSrc = "",
	editorImageAlt = "",
	publishedDate = "2026-07-01",
	updatedDate = "2026-07-01",
	readTime = "8 min read",
	imageSrc = "",
	imageAlt = "Intent & Proof editorial guide visual",
	heroImageSrc = imageSrc,
	heroImageAlt = imageAlt,
	heroImagePosition = "center",
	heroLayout = "split",
	heroTone = "aurora",
	showDescription = true,
	videoUrl = "",
	ctaEyebrow = "Intent & Proof Audit",
	ctaTitle = "Want to find the weak points in your website?",
	ctaText = "Get a practical audit of your SEO, landing page, tracking and lead path before spending more on traffic.",
	ctaLabel = "Check My Site",
	ctaHref = "/diagnostic/",
	sidebarEyebrow = "Free diagnostic",
	sidebarTitle = "Find the first commercial leak worth fixing.",
	sidebarText = "A focused review of intent, proof, conversion and measurement before more budget is committed.",
	sidebarLabel = "Request diagnostic",
	sidebarHref = "/diagnostic/",
	showToc = true,
	showShare = true,
	showSidebarCta = true,
	showComments = false,
	commentsRepo = "",
	commentsRepoId = "",
	commentsCategory = "General",
	commentsCategoryId = "",
	commentsMapping = "pathname",
	commentsTheme = "preferred_color_scheme",
	commentsLang = "en",
	layoutVariant = "wide",
	locale = "en",
	articleId = "",
	showRelatedContent = true,
	relatedCategoryIds = [],
	relatedTags = [],
	relatedManualArticleIds = [],
	relatedContentLimit = 4,
	relatedContentTitle = "",
	relatedContentText = "",
	breadcrumbs = [
		{ href: "/", label: "Home" },
		{ href: "/blog/", label: "Research" }
	],
	tags = [],
	toc = [
		{ href: "#overview", label: "Overview" },
		{ href: "#system", label: "The system" },
		{ href: "#checklist", label: "Checklist" },
		{ href: "#faq", label: "FAQ" }
	]
} = Astro.props;

const resolvedAuthorImageAlt = authorImageAlt || `${author} portrait`;
const resolvedEditorImageAlt = editorImageAlt || `${editor} portrait`;
const siteURL = Astro.site ?? new URL("https://www.intentandproof.com");
const articleURL = new URL(Astro.url.pathname, siteURL);
const articleImage = heroImageSrc ? new URL(heroImageSrc, siteURL).toString() : undefined;
const editorialComponentCount = Object.keys(editorialComponents).length;
const contentLocale = locale === "it" ? "it" : "en";
const resolvedRelatedTags = relatedTags.length > 0
	? relatedTags
	: tags.map((tag) => typeof tag === "string" ? tag : tag.label).filter(Boolean);

const articleSchema = {
	"@type": "Article",
	headline: title,
	description,
	mainEntityOfPage: articleURL.toString(),
	datePublished: publishedDate,
	dateModified: updatedDate,
	author: {
		"@type": "Person",
		name: author,
		url: new URL(authorHref, siteURL).toString()
	},
	...(editor ? {
		editor: {
			"@type": "Person",
			name: editor,
			...(editorHref ? { url: new URL(editorHref, siteURL).toString() } : {})
		}
	} : {}),
	publisher: {
		"@type": "Organization",
		name: "Intent & Proof",
		url: siteURL.toString()
	},
	...(articleImage ? { image: articleImage } : {})
};

const breadcrumbSchema = {
	"@type": "BreadcrumbList",
	itemListElement: [
		...breadcrumbs.map((item, index) => ({
			"@type": "ListItem",
			position: index + 1,
			name: item.label,
			item: new URL(item.href, siteURL).toString()
		})),
		{
			"@type": "ListItem",
			position: breadcrumbs.length + 1,
			name: title,
			item: articleURL.toString()
		}
	]
};

const structuredData = {
	"@context": "https://schema.org",
	"@graph": [articleSchema, breadcrumbSchema]
};
---

<BaseLayout
	title={title}
	description={description}
	image={heroImageSrc}
	ogType="article"
	publishedDate={publishedDate}
	updatedDate={updatedDate}
	author={author}
	lang={contentLocale}
	structuredData={structuredData}
	showRelatedContent={showRelatedContent}
	relatedContent={{
		currentId: articleId,
		currentHref: Astro.url.pathname,
		categoryIds: relatedCategoryIds,
		tags: resolvedRelatedTags,
		manualArticleIds: relatedManualArticleIds,
		limit: relatedContentLimit,
		title: relatedContentTitle || (contentLocale === "it" ? "Altri approfondimenti sul tema." : "More research on this topic."),
		text: relatedContentText || (contentLocale === "it" ? "Una selezione automatica degli articoli più recenti e pertinenti." : "An automatic selection of the most recent and relevant articles."),
		allHref: contentLocale === "it" ? "/it/blog/" : "/blog/",
		allLabel: contentLocale === "it" ? "Vedi tutti gli articoli" : "View all research"
	}}
>
	<article class={`article-shell article-shell--${layoutVariant}`} data-editorial-components={editorialComponentCount}>
		<ArticleHero
			title={title}
			description={description}
			eyebrow={eyebrow}
			categoryHref={categoryHref}
			breadcrumbs={breadcrumbs}
			tags={tags}
			publishedDate={publishedDate}
			updatedDate={updatedDate}
			readTime={readTime}
			author={author}
			authorHref={authorHref}
			authorRole={authorRole}
			authorImageSrc={authorImageSrc}
			authorImageAlt={resolvedAuthorImageAlt}
			editor={editor}
			editorHref={editorHref}
			editorImageSrc={editorImageSrc}
			editorImageAlt={resolvedEditorImageAlt}
			heroImageSrc={heroImageSrc}
			heroImageAlt={heroImageAlt}
			heroImagePosition={heroImagePosition}
			heroLayout={heroLayout}
			heroTone={heroTone}
			showDescription={showDescription}
			videoUrl={videoUrl}
		/>

		<div class="article-editorial-frame">
			<aside class="article-left-rail" aria-label="Article navigation and sharing">
				{showToc && <TableOfContents items={toc} />}
				{showShare && <ShareBar title={title} url={articleURL.toString()} />}
			</aside>

			<div class="article-content"><slot /></div>

			{
				showSidebarCta && (
					<SidebarCta
						eyebrow={sidebarEyebrow}
						title={sidebarTitle}
						text={sidebarText}
						label={sidebarLabel}
						href={sidebarHref}
					/>
				)
			}
		</div>

		<ArticleFooter
			author={author}
			authorHref={authorHref}
			authorBio={authorBio}
			authorImageSrc={authorImageSrc}
			authorImageAlt={resolvedAuthorImageAlt}
			ctaEyebrow={ctaEyebrow}
			ctaTitle={ctaTitle}
			ctaText={ctaText}
			ctaLabel={ctaLabel}
			ctaHref={ctaHref}
		>
			{
				showComments && commentsRepo && commentsRepoId && commentsCategoryId && (
					<GiscusComments
						repo={commentsRepo}
						repoId={commentsRepoId}
						category={commentsCategory}
						categoryId={commentsCategoryId}
						mapping={commentsMapping}
						theme={commentsTheme}
						lang={commentsLang}
					/>
				)
			}
		</ArticleFooter>
	</article>
</BaseLayout>
