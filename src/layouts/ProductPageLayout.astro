---
import BaseLayout from "./BaseLayout.astro";
import "../styles/product-page.css";

const {
	title,
	description,
	canonicalPath = "",
	image = "",
	lang = "en",
	noindex = true,
	nofollow = false,
	structuredData = null,
	alternates = []
} = Astro.props;

const contentLocale = lang === "it" ? "it" : "en";
const currentPath = canonicalPath || Astro.url.pathname;

const pairedProductPaths: Record<string, string> = {
	"/products/local-market-capture-system/": "/it/prodotti/seo-locale-attivita/",
	"/it/prodotti/seo-locale-attivita/": "/products/local-market-capture-system/"
};

const pairedPath = pairedProductPaths[currentPath];
const inferredAlternates = pairedPath
	? currentPath.startsWith("/it/")
		? [
			{ locale: "en", href: pairedPath },
			{ locale: "it", href: currentPath },
			{ locale: "en", href: pairedPath, isDefault: true }
		]
		: [
			{ locale: "en", href: currentPath },
			{ locale: "it", href: pairedPath },
			{ locale: "en", href: currentPath, isDefault: true }
		]
	: currentPath.startsWith("/products/")
		? [
			{ locale: "en", href: currentPath },
			{ locale: "it", href: currentPath.replace(/^\/products\//, "/it/prodotti/") },
			{ locale: "en", href: currentPath, isDefault: true }
		]
		: currentPath.startsWith("/it/prodotti/")
			? [
				{ locale: "en", href: currentPath.replace(/^\/it\/prodotti\//, "/products/") },
				{ locale: "it", href: currentPath },
				{ locale: "en", href: currentPath.replace(/^\/it\/prodotti\//, "/products/"), isDefault: true }
			]
			: [];
---

<BaseLayout
	title={title}
	description={description}
	canonicalPath={canonicalPath}
	image={image}
	lang={contentLocale}
	alternates={alternates.length > 0 ? alternates : inferredAlternates}
	noindex={noindex}
	nofollow={nofollow}
	structuredData={structuredData}
	showRelatedContent={false}
>
	<div class="pp-page">
		<slot />
	</div>
</BaseLayout>
