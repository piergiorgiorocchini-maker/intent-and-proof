---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { diagnosticCopy } from "../../lib/i18n/diagnostic";
import { resolvePublishedLocale } from "../../lib/i18n/ui";
import "../../styles/diagnostic-tool.css";

const contentLocale = resolvePublishedLocale(Astro.props.locale);
const copy = diagnosticCopy[contentLocale];
const runtimeLabels = {
	en: { qualifiedLeadRate: "Qualified lead rate" },
	it: { qualifiedLeadRate: "Quota di contatti qualificati" }
} as const;
const clientCopy = {
	...copy.client,
	labels: {
		...copy.client.labels,
		...runtimeLabels[contentLocale]
	}
};
const adsAnswers = [
	copy.assessment.answers[3],
	copy.assessment.answers[0],
	copy.assessment.answers[1],
	copy.assessment.answers[2]
];
const alternates = [
	{ locale: "en", href: "/diagnostic/" },
	{ locale: "it", href: "/it/diagnostic/" },
	{ locale: "en", href: "/diagnostic/", isDefault: true }
];
---

<BaseLayout
	title={copy.meta.title}
	description={copy.meta.description}
	lang={contentLocale}
	canonicalPath={copy.meta.canonical}
	alternates={alternates}
	showRelatedContent={false}
>
	<div class="diagnostic-page" data-diagnostic-tool data-locale={contentLocale}>
		<script type="application/json" data-diagnostic-copy set:html={JSON.stringify(clientCopy)} />

		<section class="diagnostic-hero">
			<div class="diagnostic-shell diagnostic-hero__grid">
				<div>
					<p class="diagnostic-eyebrow">{copy.hero.eyebrow}</p>
					<h1>{copy.hero.title}</h1>
					<p class="diagnostic-hero__intro">{copy.hero.intro}</p>
					<p class="diagnostic-hero__note">{copy.hero.note}</p>
				</div>

				<aside class="diagnostic-preview" aria-label={copy.preview.aria}>
					<div class="diagnostic-preview__top">
						<p class="diagnostic-preview__label">{copy.preview.label}</p>
						<span>{copy.preview.mode}</span>
					</div>
					<p class="diagnostic-preview__score">68<span>/100</span></p>
					<p class="diagnostic-preview__status">{copy.preview.status}</p>
					<div class="diagnostic-preview__rows">
						{copy.preview.rows.map((row) => (
							<div class="diagnostic-preview__row">
								<span>{row.label}</span><strong>{row.value}</strong>
								<div class="diagnostic-preview__bar"><span style={`width:${row.value}%`}></span></div>
							</div>
						))}
					</div>
				</aside>
			</div>
		</section>

		<main class="diagnostic-main">
			<form class="diagnostic-shell diagnostic-tool" novalidate>
				<section class="diagnostic-panel" aria-labelledby="diagnostic-start-title">
					<span class="diagnostic-step">01</span>
					<p class="diagnostic-section__eyebrow">{copy.start.eyebrow}</p>
					<h2 id="diagnostic-start-title">{copy.start.title}</h2>
					<p class="diagnostic-panel__intro">{copy.start.intro}</p>

					<div class="diagnostic-form-grid">
						<div class="diagnostic-field">
							<label for="diagnostic-website">{copy.start.website}</label>
							<input id="diagnostic-website" name="website" type="url" inputmode="url" autocomplete="url" placeholder="https://example.com" />
						</div>
						<div class="diagnostic-field">
							<label for="diagnostic-business-type">{copy.start.businessType}</label>
							<select id="diagnostic-business-type" name="businessType">
								{copy.start.businessTypes.map((option) => <option value={option.value}>{option.label}</option>)}
							</select>
						</div>
						<div class="diagnostic-field">
							<label for="diagnostic-objective">{copy.start.objective}</label>
							<select id="diagnostic-objective" name="objective">
								{copy.start.objectives.map((option) => <option value={option.value}>{option.label}</option>)}
							</select>
						</div>
					</div>

					<p class="diagnostic-error" data-url-error hidden>{copy.start.urlError}</p>
					<div class="diagnostic-actions">
						<button class="diagnostic-button" type="button" data-run-scan>{copy.start.run}</button>
						<p class="diagnostic-status" data-scan-status>{copy.start.status}</p>
					</div>
				</section>

				<section class="diagnostic-panel" data-assessment-panel hidden aria-labelledby="diagnostic-assessment-title">
					<span class="diagnostic-step">02</span>
					<p class="diagnostic-section__eyebrow">{copy.assessment.eyebrow}</p>
					<h2 id="diagnostic-assessment-title">{copy.assessment.title}</h2>
					<p class="diagnostic-panel__intro">{copy.assessment.intro}</p>

					<div class="diagnostic-question-list">
						{copy.assessment.questions.map((question) => (
							<fieldset class="diagnostic-question" data-commercial-question data-category={question.category} data-name={question.name}>
								<legend>{question.legend}</legend>
								<div class="diagnostic-options">
									{copy.assessment.answers.map((answer) => (
										<label class="diagnostic-option">
											<input type="radio" name={question.name} value={answer.value} />
											<span>{answer.label}</span>
										</label>
									))}
								</div>
							</fieldset>
						))}
					</div>

					<div class="ads-toggle diagnostic-field">
						<label for="diagnostic-ads">{copy.assessment.usesAds}</label>
						<select id="diagnostic-ads" name="usesAds">
							<option value="no">{copy.assessment.noAds}</option>
							<option value="yes">{copy.assessment.yesAds}</option>
						</select>
					</div>

					<div class="ads-fields" data-ads-fields hidden>
						<div>
							<p class="diagnostic-section__eyebrow">{copy.assessment.adsEyebrow}</p>
							<p class="diagnostic-panel__intro">{copy.assessment.adsIntro}</p>
							<div class="ads-metrics">
								<div class="diagnostic-field"><label for="ads-impressions">{copy.assessment.adsFields.impressions}</label><input id="ads-impressions" name="adsImpressions" type="number" min="0" inputmode="numeric" /></div>
								<div class="diagnostic-field"><label for="ads-clicks">{copy.assessment.adsFields.clicks}</label><input id="ads-clicks" name="adsClicks" type="number" min="0" inputmode="numeric" /></div>
								<div class="diagnostic-field"><label for="ads-cost">{copy.assessment.adsFields.spend}</label><input id="ads-cost" name="adsCost" type="number" min="0" step="0.01" inputmode="decimal" /></div>
								<div class="diagnostic-field"><label for="ads-conversions">{copy.assessment.adsFields.leads}</label><input id="ads-conversions" name="adsConversions" type="number" min="0" inputmode="numeric" /></div>
								<div class="diagnostic-field"><label for="ads-qualified">{copy.assessment.adsFields.qualified}</label><input id="ads-qualified" name="adsQualified" type="number" min="0" inputmode="numeric" /></div>
								<div class="diagnostic-field"><label for="ads-target-cpl">{copy.assessment.adsFields.targetCpl}</label><input id="ads-target-cpl" name="adsTargetCpl" type="number" min="0" step="0.01" inputmode="decimal" /></div>
							</div>
						</div>

						<div class="diagnostic-form-grid">
							<div class="diagnostic-field">
								<label for="ads-tracking">{copy.assessment.adsFields.tracking}</label>
								<select id="ads-tracking" name="adsTracking">{adsAnswers.map((answer) => <option value={answer.value}>{answer.label}</option>)}</select>
							</div>
							<div class="diagnostic-field">
								<label for="ads-terms">{copy.assessment.adsFields.terms}</label>
								<select id="ads-terms" name="adsTerms">{adsAnswers.map((answer) => <option value={answer.value}>{answer.label}</option>)}</select>
							</div>
							<div class="diagnostic-field">
								<label for="ads-negatives">{copy.assessment.adsFields.negatives}</label>
								<select id="ads-negatives" name="adsNegatives">{adsAnswers.map((answer) => <option value={answer.value}>{answer.label}</option>)}</select>
							</div>
							<div class="diagnostic-field">
								<label for="ads-landing">{copy.assessment.adsFields.landing}</label>
								<select id="ads-landing" name="adsLanding">{adsAnswers.map((answer) => <option value={answer.value}>{answer.label}</option>)}</select>
							</div>
						</div>
					</div>

					<p class="diagnostic-error" data-question-error hidden>{copy.assessment.questionError}</p>
					<div class="diagnostic-actions">
						<button class="diagnostic-button" type="button" data-generate-score disabled>{copy.assessment.generate}</button>
					</div>
				</section>

				<section class="diagnostic-results" data-results hidden aria-live="polite" aria-labelledby="diagnostic-result-title">
					<div class="results-head">
						<div class="results-score"><b data-total-score>--</b><span>/100</span></div>
						<div>
							<p class="diagnostic-section__eyebrow">{copy.results.eyebrow}</p>
							<h2 id="diagnostic-result-title" data-result-band>{copy.results.title}</h2>
							<p class="results-summary" data-result-summary></p>
						</div>
					</div>

					<div class="results-grid">
						<article class="result-card">
							<p class="result-card__label">{copy.results.technical}</p>
							<p class="result-card__value" data-technical-score>--</p>
							<p class="result-card__meta">{copy.results.technicalMeta}</p>
						</article>
						<article class="result-card">
							<p class="result-card__label">{copy.results.commercial}</p>
							<p class="result-card__value" data-commercial-score>--</p>
							<p class="result-card__meta">{copy.results.commercialMeta}</p>
						</article>
						<article class="result-card">
							<p class="result-card__label">{copy.results.ads}</p>
							<p class="result-card__value" data-ads-score>--</p>
							<p class="result-card__meta">{copy.results.adsMeta}</p>
						</article>
					</div>

					<div class="results-metrics" data-result-metrics></div>

					<div class="results-diagnosis">
						<div class="results-diagnosis__box">
							<h3>{copy.results.signals}</h3>
							<ul data-result-signals></ul>
						</div>
						<div class="results-diagnosis__box results-diagnosis__box--action">
							<h3>{copy.results.priority} <span data-priority-label></span></h3>
							<p data-priority-action></p>
						</div>
					</div>

					<div class="results-contact">
						<h3>{copy.results.contactTitle}</h3>
						<p>{copy.results.contactText}</p>
						<div class="results-contact__grid">
							<input name="contactName" type="text" autocomplete="name" placeholder={copy.results.name} aria-label={copy.results.name} />
							<input name="contactEmail" type="email" autocomplete="email" placeholder={copy.results.email} aria-label={copy.results.email} />
							<button class="diagnostic-button" type="button" data-send-result>{copy.results.send}</button>
						</div>
						<div class="diagnostic-actions">
							<button class="diagnostic-button diagnostic-button--secondary" type="button" data-copy-result>{copy.results.copy}</button>
						</div>
						<p class="results-disclaimer">{copy.results.disclaimer}</p>
					</div>
				</section>
			</form>
		</main>
	</div>

	<script src="../../scripts/diagnostic-tool.js"></script>
</BaseLayout>