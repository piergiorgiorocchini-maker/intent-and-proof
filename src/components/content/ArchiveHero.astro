---
interface BreadcrumbItem {
	label: string;
	href: string;
}

interface Props {
	eyebrow?: string;
	title: string;
	description: string;
	breadcrumbs?: BreadcrumbItem[];
	meta?: string;
	tone?: "navy" | "mint" | "cobalt" | "orange" | "neutral";
	locale?: "en" | "it";
}

const locale = Astro.props.locale
	|| (Astro.url.pathname.startsWith("/it/") ? "it" : "en");
const copy = locale === "it"
	? { eyebrow: "Approfondimenti Intent & Proof", breadcrumb: "Percorso di navigazione" }
	: { eyebrow: "Intent & Proof Research", breadcrumb: "Breadcrumb" };
const {
	eyebrow = copy.eyebrow,
	title,
	description,
	breadcrumbs = [],
	meta = "",
	tone = "navy"
} = Astro.props;
---

<header class={`content-archive-hero content-archive-hero--${tone}`}>
	<div class="content-archive-hero__inner">
		{breadcrumbs.length > 0 && (
			<nav class="content-archive-hero__breadcrumbs" aria-label={copy.breadcrumb}>
				{breadcrumbs.map((item, index) => (
					<>
						{index > 0 && <span aria-hidden="true">/</span>}
						<a href={item.href}>{item.label}</a>
					</>
				))}
			</nav>
		)}
		<p class="content-archive-hero__eyebrow">{eyebrow}</p>
		<h1>{title}</h1>
		<p class="content-archive-hero__description">{description}</p>
		{meta && <p class="content-archive-hero__meta">{meta}</p>}
	</div>
</header>