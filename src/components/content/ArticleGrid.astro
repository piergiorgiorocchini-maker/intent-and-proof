---
import ArticleCard from "./ArticleCard.astro";
import type { ArticleIndexItem } from "../../lib/content/interlinking";

interface Props {
	articles: ArticleIndexItem[];
	title?: string;
	description?: string;
	emptyText?: string;
	locale?: "en" | "it";
}

const inferredLocale = Astro.props.locale
	|| Astro.props.articles?.[0]?.locale
	|| (Astro.url.pathname.startsWith("/it/") ? "it" : "en");
const locale = inferredLocale === "it" ? "it" : "en";
const copy = locale === "it"
	? { empty: "Non sono ancora disponibili articoli pubblicati.", archive: "Archivio degli articoli" }
	: { empty: "No published articles are available yet.", archive: "Article archive" };
const {
	articles,
	title = "",
	description = "",
	emptyText = copy.empty
} = Astro.props;
---

<section class="content-archive-list" aria-label={title || copy.archive}>
	<div class="content-archive-list__inner">
		{(title || description) && (
			<header class="content-archive-list__head">
				{title && <h2>{title}</h2>}
				{description && <p>{description}</p>}
			</header>
		)}
		{
			articles.length > 0 ? (
				<div class="content-archive-list__grid">
					{articles.map((article) => <ArticleCard article={article} />)}
				</div>
			) : (
				<p class="content-archive-list__empty">{emptyText}</p>
			)
		}
	</div>
</section>