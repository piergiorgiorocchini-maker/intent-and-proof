---
import ArticleCard from "./ArticleCard.astro";
import {
	getPublishedArticleIndex,
	selectRelatedArticles
} from "../../lib/content/interlinking";
import { resolvePublishedLocale, uiCopy, type PublishedLocale } from "../../lib/i18n/ui";

interface Props {
	locale?: PublishedLocale;
	eyebrow?: string;
	title?: string;
	text?: string;
	currentId?: string;
	currentHref?: string;
	categoryIds?: string[];
	tags?: string[];
	manualArticleIds?: string[];
	limit?: number;
	fallbackToLatest?: boolean;
	allHref?: string;
	allLabel?: string;
	compact?: boolean;
}

const contentLocale = resolvePublishedLocale(Astro.props.locale);
const copy = uiCopy[contentLocale];
const articleCopy = copy.article;
const {
	eyebrow = articleCopy.relatedEyebrow,
	title = articleCopy.relatedTitle,
	text = articleCopy.relatedText,
	currentId = "",
	currentHref = "",
	categoryIds = [],
	tags = [],
	manualArticleIds = [],
	limit = 4,
	fallbackToLatest = true,
	allHref = copy.routes.blog,
	allLabel = articleCopy.relatedAll,
	compact = false
} = Astro.props;

const articleIndex = await getPublishedArticleIndex(contentLocale);
const articles = selectRelatedArticles(articleIndex, {
	locale: contentLocale,
	currentId,
	currentHref,
	categoryIds,
	tags,
	manualArticleIds,
	limit,
	fallbackToLatest
});
---

{
	articles.length > 0 && (
		<section class:list={["content-discovery", compact && "content-discovery--compact"]} aria-labelledby="content-discovery-title">
			<div class="content-discovery__inner">
				<header class="content-discovery__head">
					<div>
						<p>{eyebrow}</p>
						<h2 id="content-discovery-title">{title}</h2>
						{text && <span>{text}</span>}
					</div>
					<a href={allHref}>{allLabel}<i aria-hidden="true">↗</i></a>
				</header>
				<div class="content-discovery__grid">
					{articles.map((article) => <ArticleCard article={article} compact={compact} />)}
				</div>
			</div>
		</section>
	)
}