---
import { getPublishedArticleIndex } from "../../lib/content/interlinking";

const latestArticles = (await getPublishedArticleIndex("en")).slice(0, 3);
const imageRules = latestArticles
	.flatMap((article, index) => {
		if (!article.image) return [];

		const card = `.hp-research-card:nth-child(${index + 1}) .hp-research-card__graphic`;
		return [
			`${card} { background-image: url("${article.image.src}"); background-position: center; background-repeat: no-repeat; background-size: cover; }`,
			`${card}::after { display: none; }`
		];
	})
	.join("\n");
---

{
	imageRules && (
		<style is:inline set:html={imageRules} />
	)
}
