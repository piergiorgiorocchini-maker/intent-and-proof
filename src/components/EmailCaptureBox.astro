---
import { getGlobalSettings, localizedPath, resolveFormHandler } from "../lib/settings";

const locale = Astro.props.lang === "it" ? "it" : "en";
const localizedDefaults = locale === "it"
	? {
		eyebrow: "Analisi gratuita",
		title: "Individua le dispersioni del sito prima di acquistare altro traffico.",
		text: "Ottieni una verifica pratica di struttura SEO, chiarezza della landing page, tracciamento, inviti all'azione e visibilità nelle ricerche AI.",
		placeholder: "Indirizzo email",
		buttonLabel: "Analizza il mio sito",
		note: "Niente spam. Soltanto un prossimo passo concreto.",
		namePlaceholder: "Il tuo nome",
		websitePlaceholder: "Indirizzo del sito",
		successMessage: "Grazie. La richiesta è stata ricevuta.",
		errorMessage: "Il modulo non è ancora collegato. Utilizza invece l'opzione di contatto."
	}
	: {
		eyebrow: "Free Growth Audit",
		title: "Find the leaks in your website before buying more traffic.",
		text: "Get a practical Intent & Proof check covering SEO structure, landing page clarity, tracking, calls to action and AI-search visibility.",
		placeholder: "Email address",
		buttonLabel: "Check My Site",
		note: "No spam. Just a practical next step.",
		namePlaceholder: "Your name",
		websitePlaceholder: "Website URL",
		successMessage: "Thank you. Your request has been received.",
		errorMessage: "This form is not connected yet. Please use the contact option instead."
	};
const {
	eyebrow = localizedDefaults.eyebrow,
	title = localizedDefaults.title,
	text = localizedDefaults.text,
	placeholder = localizedDefaults.placeholder,
	buttonLabel = localizedDefaults.buttonLabel,
	note = localizedDefaults.note,
	variant = "default",
	action = "#",
	method = "",
	formName = "intent-and-proof-email-capture",
	handlerId = "newsletter",
	showName = false,
	includeWebsite = false,
	namePlaceholder = localizedDefaults.namePlaceholder,
	websitePlaceholder = localizedDefaults.websitePlaceholder,
	successMessage = localizedDefaults.successMessage,
	errorMessage = localizedDefaults.errorMessage,
	compact = false
} = Astro.props;

const settings = await getGlobalSettings();
const handler = resolveFormHandler(settings, handlerId, "newsletter");
const handlerEnabled = Boolean(handler?.enabled && handler.provider !== "disabled" && handler.endpoint);
const resolvedAction = action !== "#" ? action : handler?.endpoint || "#";
const resolvedMethod = method || handler?.method || "post";
const successPath = localizedPath(handler, locale);
const redirectUrl = new URL(successPath, settings.site.baseUrl).toString();
const fieldLabels = locale === "it"
	? { name: "Nome", email: "Email", website: "Sito web" }
	: { name: "Name", email: "Email", website: "Website" };

const captureClass = [
	"email-capture",
	`email-capture--${variant}`,
	compact ? "email-capture--compact" : ""
].filter(Boolean).join(" ");

const titleId = `${formName}-title`;
---

<section class={captureClass} aria-labelledby={titleId}>
	<div class="email-capture__copy">
		{eyebrow && <p class="email-capture__eyebrow">{eyebrow}</p>}
		<h2 id={titleId}>{title}</h2>
		{text && <p class="email-capture__text">{text}</p>}
	</div>

	<form
		class="email-capture__form"
		name={formName}
		action={resolvedAction}
		method={resolvedMethod}
		data-managed-form
		data-handler-id={handler?.id || handlerId}
		data-handler-enabled={String(handlerEnabled)}
		data-form-purpose={handler?.purpose || "newsletter"}
		data-event-name={handler?.eventName || settings.tracking.events.emailSignup}
		data-submission-mode={handler?.submissionMode || "fetch"}
		data-success-mode={handler?.successMode || "inline"}
		data-success-path={successPath}
	>
		<input type="hidden" name="form-name" value={formName} />
		<input type="hidden" name="locale" value={locale} />
		<input type="hidden" name="page_path" value={Astro.url.pathname} />
		{handler?.redirectFieldName && <input type="hidden" name={handler.redirectFieldName} value={redirectUrl} />}
		{handler?.hiddenFields.map((field) => <input type="hidden" name={field.name} value={field.value} />)}

		{showName && (
			<label class="email-capture__field">
				<span>{fieldLabels.name}</span>
				<input
					type="text"
					name="name"
					placeholder={namePlaceholder}
					autocomplete="name"
				/>
			</label>
		)}

		<label class="email-capture__field">
			<span>{fieldLabels.email}</span>
			<input
				type="email"
				name="email"
				placeholder={placeholder}
				autocomplete="email"
				required
			/>
		</label>

		{includeWebsite && (
			<label class="email-capture__field">
				<span>{fieldLabels.website}</span>
				<input
					type="url"
					name="website"
					placeholder={websitePlaceholder}
					autocomplete="url"
				/>
			</label>
		)}

		<button class="email-capture__button" type="submit" data-cta data-tracking-id={handler?.id || handlerId}>{buttonLabel}</button>

		{note && <p class="email-capture__note">{note}</p>}
		<p class="email-capture__note" data-form-success hidden>{successMessage}</p>
		<p class="form-configuration-error" data-form-error hidden>{errorMessage}</p>
	</form>
</section>