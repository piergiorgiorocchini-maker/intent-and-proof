---
const { lang = "en" } = Astro.props;
const currentYear = new Date().getFullYear();
const contactEmail =
	"mailto:piergiorgio.rocchini@gmail.com?subject=Intent%20%26%20Proof%20Enquiry";
const researchEmail =
	"mailto:piergiorgio.rocchini@gmail.com?subject=Intent%20%26%20Proof%20Research%20Notes&body=Please%20add%20me%20to%20Intent%20%26%20Proof%20Research%20Notes.%0A%0AEmail%3A";
const trackingNoticeLabel = lang === "it" ? "Informativa analytics" : "Analytics notice";
const socialLabel = lang === "it" ? "Canali social" : "Social channels";
const socialPlaceholderLabel = lang === "it" ? "profilo in preparazione" : "profile coming soon";
---

<footer class="site-footer">
	<section class="footer-cta" aria-labelledby="footer-cta-title">
		<div class="footer-cta-inner">
			<p class="footer-eyebrow">Start with a diagnostic</p>
			<h2 id="footer-cta-title" class="footer-heading">
				Find where your business is losing demand.
			</h2>
			<p class="footer-copy">
				We examine how your website captures intent, builds trust, creates action and measures the outcome — then identify what should be fixed first.
			</p>
			<div class="footer-cta-actions">
				<a class="footer-primary-link" href="/diagnostic/" data-cta data-tracking-id="footer-diagnostic">Request a Diagnostic</a>
				<a class="footer-secondary-link" href="/blog/category/case-studies/" data-cta data-tracking-id="footer-case-studies">View Case Studies</a>
			</div>
		</div>
	</section>

	<div class="footer-main">
		<div class="footer-brand">
			<a class="footer-logo" href="/" aria-label="Intent & Proof home">
				<img src="/brand/intent-proof-wordmark-negative.svg" width="276" height="36" alt="Intent & Proof" />
			</a>
			<p class="footer-tagline">
				Measurable customer acquisition systems for service businesses — connecting search, websites, proof, conversion and tracking.
			</p>

			<div class="footer-socials" aria-label={socialLabel}>
				<p>{socialLabel}</p>
				<div class="footer-socials__list">
					<span class="footer-social-placeholder" role="img" aria-label={`LinkedIn ${socialPlaceholderLabel}`} title={`LinkedIn ${socialPlaceholderLabel}`}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M6.5 8.2H3.2V21h3.3V8.2ZM4.85 3A1.92 1.92 0 1 0 4.85 6.84 1.92 1.92 0 0 0 4.85 3ZM21 13.66c0-3.85-2.05-5.64-4.79-5.64-2.2 0-3.19 1.21-3.75 2.06V8.2H9.17V21h3.29v-6.34c0-1.67.32-3.29 2.39-3.29 2.04 0 2.06 1.91 2.06 3.4V21H21v-7.34Z" />
						</svg>
					</span>
					<span class="footer-social-placeholder" role="img" aria-label={`YouTube ${socialPlaceholderLabel}`} title={`YouTube ${socialPlaceholderLabel}`}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M23 12s0-3.3-.42-4.9a3.15 3.15 0 0 0-2.22-2.23C18.4 4.33 12 4.33 12 4.33s-6.4 0-8.36.54A3.15 3.15 0 0 0 1.42 7.1C1 8.7 1 12 1 12s0 3.3.42 4.9a3.15 3.15 0 0 0 2.22 2.23c1.96.54 8.36.54 8.36.54s6.4 0 8.36-.54a3.15 3.15 0 0 0 2.22-2.23C23 15.3 23 12 23 12Zm-13.2 3.2V8.8l5.54 3.2-5.54 3.2Z" />
						</svg>
					</span>
					<span class="footer-social-placeholder" role="img" aria-label={`Instagram ${socialPlaceholderLabel}`} title={`Instagram ${socialPlaceholderLabel}`}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M7.4 2h9.2A5.4 5.4 0 0 1 22 7.4v9.2a5.4 5.4 0 0 1-5.4 5.4H7.4A5.4 5.4 0 0 1 2 16.6V7.4A5.4 5.4 0 0 1 7.4 2Zm0 2A3.4 3.4 0 0 0 4 7.4v9.2A3.4 3.4 0 0 0 7.4 20h9.2a3.4 3.4 0 0 0 3.4-3.4V7.4A3.4 3.4 0 0 0 16.6 4H7.4Zm9.85 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z" />
						</svg>
					</span>
					<span class="footer-social-placeholder" role="img" aria-label={`Facebook ${socialPlaceholderLabel}`} title={`Facebook ${socialPlaceholderLabel}`}>
						<svg viewBox="0 0 24 24" aria-hidden="true">
							<path d="M13.8 22v-8h2.7l.4-3.1h-3.1v-2c0-.9.25-1.5 1.55-1.5H17V4.62c-.29-.04-1.28-.12-2.43-.12-2.4 0-4.04 1.46-4.04 4.15v2.25H7.8V14h2.73v8h3.27Z" />
						</svg>
					</span>
				</div>
			</div>
		</div>

		<nav class="footer-columns" aria-label="Footer navigation">
			<div class="footer-column">
				<h3 class="footer-column-title">System</h3>
				<ul class="footer-link-list">
					<li><a href="/diagnostic/">Diagnostic</a></li>
					<li><a href="/#services">Services</a></li>
					<li><a href="/products/local-authority-engine/">Local Authority Engine</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h3 class="footer-column-title">Proof</h3>
				<ul class="footer-link-list">
					<li><a href="/blog/category/case-studies/">Case Studies</a></li>
					<li><a href="/blog/category/local-seo/">Local SEO Research</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h3 class="footer-column-title">Research</h3>
				<ul class="footer-link-list">
					<li><a href="/blog/">Latest Research</a></li>
					<li><a href="/blog/local-service-lead-generation/">Lead Generation Guide</a></li>
					<li><a href={researchEmail}>Research Notes</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h3 class="footer-column-title">Company</h3>
				<ul class="footer-link-list">
					<li><a href="/about/">About</a></li>
					<li><a href={contactEmail}>Contact</a></li>
					<li><a href="#tracking-notice" data-open-tracking-notice>{trackingNoticeLabel}</a></li>
				</ul>
			</div>
		</nav>
	</div>

	<div class="footer-bottom">
		<p>© {currentYear} Intent &amp; Proof. All rights reserved.</p>
		<p>Intent → Proof → Action → Measurement</p>
	</div>
</footer>

<style>
	.footer-logo {
		display: inline-flex;
		width: min(276px, 100%);
		align-items: center;
	}

	.footer-logo img {
		display: block;
		width: 100%;
		height: auto;
	}

	.footer-socials {
		margin-top: 26px;
	}

	.footer-socials > p {
		margin: 0 0 12px;
		color: rgba(255, 255, 255, 0.52);
		font-size: 0.72rem;
		font-weight: 800;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.footer-socials__list {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.footer-social-placeholder {
		display: inline-flex;
		width: 42px;
		height: 42px;
		align-items: center;
		justify-content: center;
		border: 1px solid rgba(255, 255, 255, 0.16);
		border-radius: 12px;
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.72);
		cursor: default;
	}

	.footer-social-placeholder svg {
		width: 18px;
		height: 18px;
		fill: currentColor;
	}
</style>