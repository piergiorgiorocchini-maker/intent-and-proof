---
const currentYear = new Date().getFullYear();
const contactEmail =
	"mailto:piergiorgio.rocchini@gmail.com?subject=Intent%20%26%20Proof%20Enquiry";
const researchEmail =
	"mailto:piergiorgio.rocchini@gmail.com?subject=Intent%20%26%20Proof%20Research%20Notes&body=Please%20add%20me%20to%20Intent%20%26%20Proof%20Research%20Notes.%0A%0AEmail%3A";
---

<footer class="site-footer">
	<section class="footer-cta" aria-labelledby="footer-cta-title">
		<div class="footer-cta-inner">
			<p class="footer-eyebrow">Start with a diagnostic</p>
			<h2 id="footer-cta-title" class="footer-heading">
				Find where your business is losing demand.
			</h2>
			<p class="footer-copy">
				We examine how your website captures intent, builds trust, creates action and measures the outcome — then identify what should be fixed first.
			</p>
			<div class="footer-cta-actions">
				<a class="footer-primary-link" href="/#diagnostic">Request a Diagnostic</a>
				<a class="footer-secondary-link" href="/case-studies/">View Case Studies</a>
			</div>
		</div>
	</section>

	<div class="footer-main">
		<div class="footer-brand">
			<a class="footer-logo" href="/">INTENT<span>&amp; PROOF</span></a>
			<p class="footer-tagline">
				Measurable customer acquisition systems for service businesses — connecting search, websites, proof, conversion and tracking.
			</p>
		</div>

		<nav class="footer-columns" aria-label="Footer navigation">
			<div class="footer-column">
				<h3 class="footer-column-title">System</h3>
				<ul class="footer-link-list">
					<li><a href="/#diagnose">Diagnostic</a></li>
					<li><a href="/#build">Conversion Foundation</a></li>
					<li><a href="/#capture">Demand Capture</a></li>
					<li><a href="/#measure">Measurement &amp; Growth</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h3 class="footer-column-title">Proof</h3>
				<ul class="footer-link-list">
					<li><a href="/case-studies/">Case Studies</a></li>
					<li><a href="/case-studies/">Local Service Systems</a></li>
					<li><a href="/case-studies/">Premium Positioning</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h3 class="footer-column-title">Research</h3>
				<ul class="footer-link-list">
					<li><a href="/blog/">Latest Research</a></li>
					<li><a href="/blog/local-service-lead-generation/">Lead Generation Guide</a></li>
					<li><a href={researchEmail}>Research Notes</a></li>
				</ul>
			</div>

			<div class="footer-column">
				<h3 class="footer-column-title">Company</h3>
				<ul class="footer-link-list">
					<li><a href="/about/">About</a></li>
					<li><a href={contactEmail}>Contact</a></li>
				</ul>
			</div>
		</nav>
	</div>

	<div class="footer-bottom">
		<p>© {currentYear} Intent &amp; Proof. All rights reserved.</p>
		<p>Intent → Proof → Action → Measurement</p>
	</div>
</footer>
