---
const {
	eyebrow = "Resource",
	title = "Intent & Proof Resource",
	text = "A practical resource for turning service websites into measurable lead generation systems.",
	href = "/",
	label = "Open resource",
	meta = "",
	icon = "→",
	variant = "default"
} = Astro.props;

const cardClass = [
	"resource-card",
	`resource-card--${variant}`
].filter(Boolean).join(" ");
---

<a class={cardClass} href={href}>
	<div class="resource-card__top">
		{eyebrow && <p class="resource-card__eyebrow">{eyebrow}</p>}
		<span class="resource-card__icon" aria-hidden="true">{icon}</span>
	</div>

	<div class="resource-card__body">
		<h3>{title}</h3>
		{text && <p>{text}</p>}
	</div>

	<div class="resource-card__footer">
		{meta && <span>{meta}</span>}
		<strong>{label}</strong>
	</div>
</a>
