---
import CommercialButton from "./CommercialButton.astro";
const { block } = Astro.props;
---

<section id={block.id} class={`commercial-section commercial-feature commercial-feature--${block.layout} commercial-section--${block.tone}`}>
	<div class="commercial-shell commercial-feature__grid">
		<div class="commercial-feature__copy">
			{block.eyebrow && <p class="commercial-eyebrow">{block.eyebrow}</p>}
			{block.title && <h2>{block.title}</h2>}
			{block.text && <p>{block.text}</p>}
			{block.proof && <strong class="commercial-feature__proof">{block.proof}</strong>}
			{block.bullets?.length > 0 && (
				<ul class="commercial-check-list">{block.bullets.map((item: string) => <li>{item}</li>)}</ul>
			)}
			{block.action && <CommercialButton action={block.action} />}
		</div>
		{block.media && (
			<figure class="commercial-feature__media">
				<img
					src={block.media.src}
					alt={block.media.alt}
					loading={block.media.loading || "lazy"}
					decoding="async"
					style={`object-position:${block.media.position || "center"}`}
				/>
				{block.media.caption && <figcaption>{block.media.caption}</figcaption>}
			</figure>
		)}
	</div>
</section>
