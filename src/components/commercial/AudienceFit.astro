---
const { block } = Astro.props;
---

<section id={block.id} class={`commercial-section commercial-audience commercial-section--${block.tone}`}>
	<div class="commercial-shell">
		<header class="commercial-section-heading commercial-section-heading--center">
			{block.eyebrow && <p class="commercial-eyebrow">{block.eyebrow}</p>}
			{block.title && <h2>{block.title}</h2>}
			{block.text && <p>{block.text}</p>}
		</header>
		<div class="commercial-audience__grid">
			<article class="commercial-audience__card commercial-audience__card--fit">
				<h3>{block.fitTitle}</h3>
				<ul>{block.fitItems.map((item: string) => <li>{item}</li>)}</ul>
			</article>
			<article class="commercial-audience__card commercial-audience__card--not-fit">
				<h3>{block.notFitTitle}</h3>
				<ul>{block.notFitItems.map((item: string) => <li>{item}</li>)}</ul>
			</article>
		</div>
		{block.note && <p class="commercial-section-note">{block.note}</p>}
	</div>
</section>
