---
import CommercialButton from "./CommercialButton.astro";
const { block } = Astro.props;

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: block.items.map((item: any) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer
		}
	}))
};
---

<section id={block.id} class={`commercial-section commercial-faq commercial-section--${block.tone}`}>
	<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<div class="commercial-shell commercial-faq__layout">
		<header class="commercial-section-heading">
			{block.eyebrow && <p class="commercial-eyebrow">{block.eyebrow}</p>}
			{block.title && <h2>{block.title}</h2>}
			{block.text && <p>{block.text}</p>}
			{block.contactText && <p class="commercial-faq__contact">{block.contactText}</p>}
			{block.contactAction && <CommercialButton action={block.contactAction} />}
		</header>
		<div class="commercial-faq__items">
			{block.items.map((item: any, index: number) => (
				<details open={index === 0}>
					<summary>{item.question}<span aria-hidden="true">+</span></summary>
					<p>{item.answer}</p>
				</details>
			))}
		</div>
	</div>
</section>
