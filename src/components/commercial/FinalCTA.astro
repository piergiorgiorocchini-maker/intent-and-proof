---
import CommercialButton from "./CommercialButton.astro";
const { block } = Astro.props;
---

<section id={block.id} class={`commercial-section commercial-final-cta commercial-section--${block.tone}`}>
	<div class="commercial-shell commercial-final-cta__card">
		<div class="commercial-final-cta__copy">
			{block.eyebrow && <p class="commercial-eyebrow">{block.eyebrow}</p>}
			{block.title && <h2>{block.title}</h2>}
			{block.text && <p>{block.text}</p>}
			<div class="commercial-actions">
				<CommercialButton action={block.primaryAction} />
				{block.secondaryAction && <CommercialButton action={block.secondaryAction} />}
			</div>
			{block.microcopy?.length > 0 && <ul class="commercial-microcopy">{block.microcopy.map((item: string) => <li>{item}</li>)}</ul>}
		</div>
		{block.media && <img class="commercial-final-cta__media" src={block.media.src} alt={block.media.alt} loading="lazy" decoding="async" />}
	</div>
</section>
