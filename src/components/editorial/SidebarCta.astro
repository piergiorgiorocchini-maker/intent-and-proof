---
interface Props {
	eyebrow?: string;
	title: string;
	text: string;
	label: string;
	href: string;
}

const {
	eyebrow = "Recommended next step",
	title,
	text,
	label,
	href
} = Astro.props;
---

<div class="article-sidebar-cta">
	{eyebrow && <p>{eyebrow}</p>}
	<h2>{title}</h2>
	<span>{text}</span>
	<a href={href}>{label}<i aria-hidden="true">↗</i></a>
</div>
