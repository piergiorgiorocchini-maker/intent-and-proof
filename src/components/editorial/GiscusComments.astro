---
interface Props {
	repo: string;
	repoId: string;
	categoryId: string;
	category?: string;
	mapping?: "pathname" | "url" | "title" | "og:title" | "specific" | "number";
	term?: string;
	strict?: boolean;
	reactionsEnabled?: boolean;
	emitMetadata?: boolean;
	inputPosition?: "top" | "bottom";
	theme?: string;
	lang?: string;
	loading?: "lazy" | "eager";
	title?: string;
}

const {
	repo,
	repoId,
	categoryId,
	category = "General",
	mapping = "pathname",
	term = "",
	strict = false,
	reactionsEnabled = true,
	emitMetadata = false,
	inputPosition = "top",
	theme = "preferred_color_scheme",
	lang = "en",
	loading = "lazy",
	title = "Discussion"
} = Astro.props;
---

<section class="editorial-comments" aria-labelledby="editorial-comments-title">
	<h2 id="editorial-comments-title">{title}</h2>
	<script
		src="https://giscus.app/client.js"
		data-repo={repo}
		data-repo-id={repoId}
		data-category={category}
		data-category-id={categoryId}
		data-mapping={mapping}
		data-term={term || undefined}
		data-strict={strict ? "1" : "0"}
		data-reactions-enabled={reactionsEnabled ? "1" : "0"}
		data-emit-metadata={emitMetadata ? "1" : "0"}
		data-input-position={inputPosition}
		data-theme={theme}
		data-lang={lang}
		data-loading={loading}
		crossorigin="anonymous"
		async
	></script>
</section>
