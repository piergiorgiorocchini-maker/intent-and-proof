---
import { localeMetadata, resolvePublishedLocale } from "../../lib/i18n/ui";
import { uiCopy } from "../../lib/i18n/ui";

interface Props {
	publishedDate: string | Date;
	updatedDate?: string | Date;
	readTime?: string;
	locale?: string;
}

const {
	publishedDate,
	updatedDate,
	readTime = "",
	locale = "en"
} = Astro.props;

const contentLocale = resolvePublishedLocale(locale);
const copy = uiCopy[contentLocale].article;
const intlLocale = localeMetadata[contentLocale].intl;
const toDate = (value: string | Date) => value instanceof Date ? value : new Date(`${value}T00:00:00`);
const toISODate = (value: string | Date) => value instanceof Date ? value.toISOString().slice(0, 10) : value;
const formatDate = (value: string | Date) => new Intl.DateTimeFormat(intlLocale, {
	day: "numeric",
	month: "long",
	year: "numeric"
}).format(toDate(value));

const publishedISO = toISODate(publishedDate);
const updatedISO = updatedDate ? toISODate(updatedDate) : "";
const showUpdated = Boolean(updatedDate && updatedISO !== publishedISO);
---

<div class="article-meta" aria-label={copy.publicationInformation}>
	<span><time datetime={publishedISO}>{formatDate(publishedDate)}</time></span>
	{showUpdated && updatedDate && <span>{copy.updated} <time datetime={updatedISO}>{formatDate(updatedDate)}</time></span>}
	{readTime && <span>{readTime}</span>}
</div>