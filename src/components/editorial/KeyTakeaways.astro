---
interface Props {
	items?: string[];
	title?: string;
	eyebrow?: string;
	locale?: "en" | "it";
}

const locale = Astro.props.locale
	|| (Astro.url.pathname.startsWith("/it/") ? "it" : "en");
const copy = locale === "it"
	? { title: "Punti chiave", eyebrow: "Sintesi" }
	: { title: "Key takeaways", eyebrow: "Summary" };
const {
	items = [],
	title = copy.title,
	eyebrow = copy.eyebrow
} = Astro.props;
---

<section class="editorial-takeaways" aria-labelledby="editorial-takeaways-title">
	{eyebrow && <p class="editorial-takeaways__eyebrow">{eyebrow}</p>}
	<h2 id="editorial-takeaways-title">{title}</h2>
	{
		items.length > 0 ? (
			<ul>{items.map((item) => <li>{item}</li>)}</ul>
		) : (
			<div class="editorial-takeaways__slot"><slot /></div>
		)
	}
</section>