---
interface FAQItem {
	question: string;
	answer: string;
}

interface Props {
	items?: FAQItem[];
	title?: string;
	showSchema?: boolean;
	locale?: "en" | "it";
}

const locale = Astro.props.locale
	|| (Astro.url.pathname.startsWith("/it/") ? "it" : "en");
const defaultTitle = locale === "it" ? "Domande frequenti" : "Frequently asked questions";
const {
	items = [],
	title = defaultTitle,
	showSchema = true
} = Astro.props;

const faqSchema = {
	"@context": "https://schema.org",
	"@type": "FAQPage",
	mainEntity: items.map((item) => ({
		"@type": "Question",
		name: item.question,
		acceptedAnswer: {
			"@type": "Answer",
			text: item.answer
		}
	}))
};
---

{
	items.length > 0 && (
		<section class="editorial-faq" aria-labelledby="editorial-faq-title">
			<h2 id="editorial-faq-title">{title}</h2>
			<div class="editorial-faq__items">
				{
					items.map((item) => (
						<details class="editorial-faq__item">
							<summary>{item.question}</summary>
							<p>{item.answer}</p>
						</details>
					))
				}
			</div>
			{showSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
		</section>
	)
}