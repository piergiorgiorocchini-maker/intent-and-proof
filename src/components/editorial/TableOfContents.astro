---
interface TocItem {
	href: string;
	label: string;
}

interface Props {
	items?: TocItem[];
	title?: string;
}

const {
	items = [],
	title = "On this page"
} = Astro.props;
---

{
	items.length > 0 && (
		<div class="article-side-card article-toc">
			<p>{title}</p>
			<nav aria-label={title}>
				{items.map((item) => <a href={item.href}>{item.label}</a>)}
			</nav>
		</div>
	)
}

<style>
	@media (min-width: 881px) {
		.article-toc {
			display: flex;
			overflow: hidden;
			max-height: clamp(300px, calc(100vh - 260px), 620px);
			min-height: 0;
			flex-direction: column;
		}

		.article-toc nav {
			overflow-y: auto;
			min-height: 0;
			padding-right: 8px;
			overscroll-behavior: contain;
			scrollbar-gutter: stable;
			scrollbar-width: thin;
		}
	}
</style>
