---
import { resolvePublishedLocale, uiCopy } from "../../lib/i18n/ui";

interface Props {
	title: string;
	url?: string;
	label?: string;
	locale?: string;
}

const {
	title,
	url = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin).toString(),
	label,
	locale = "en"
} = Astro.props;

const contentLocale = resolvePublishedLocale(locale);
const copy = uiCopy[contentLocale].article;
const resolvedLabel = label || copy.share;
const linkedInShare = `https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`;
const xShare = `https://x.com/intent/post?url=${encodeURIComponent(url)}&text=${encodeURIComponent(title)}`;
---

<div class="article-side-card article-share">
	<p>{resolvedLabel}</p>
	<div class="article-share-links">
		<a href={linkedInShare} target="_blank" rel="noopener noreferrer" aria-label={copy.shareLinkedIn}>in</a>
		<a href={xShare} target="_blank" rel="noopener noreferrer" aria-label={copy.shareX}>x</a>
		<button type="button" data-copy-article-url={url} aria-label={copy.copyLink}>⧉</button>
		<a href={url} aria-label={copy.openCanonical}>↗</a>
	</div>
</div>

<script>
	const copyButtons = document.querySelectorAll("[data-copy-article-url]");

	copyButtons.forEach((button) => {
		if (!(button instanceof HTMLButtonElement) || button.dataset.copyReady === "true") return;
		button.dataset.copyReady = "true";
		button.addEventListener("click", async () => {
			const url = button.dataset.copyArticleUrl;
			if (!url) return;
			try {
				await navigator.clipboard.writeText(url);
				button.textContent = "✓";
				window.setTimeout(() => { button.textContent = "⧉"; }, 1600);
			} catch {
				window.location.href = url;
			}
		});
	});
</script>