---
interface Props {
	label?: string;
	name: string;
	href?: string;
	role?: string;
	imageSrc?: string;
	imageAlt?: string;
	size?: number;
	variant?: "author" | "editor";
}

const {
	label = "Written by",
	name,
	href = "",
	role = "",
	imageSrc = "",
	imageAlt = `${name} portrait`,
	size = 56,
	variant = "author"
} = Astro.props;

const initials = name
	.split(" ")
	.filter(Boolean)
	.map((part) => part.charAt(0))
	.join("")
	.slice(0, 2)
	.toUpperCase();

const contributorClass = [
	"article-contributor",
	variant === "editor" ? "article-contributor--editor" : ""
].filter(Boolean).join(" ");

const avatar = imageSrc
	? <img class="article-author-avatar" src={imageSrc} alt={imageAlt} width={size} height={size} loading="eager" decoding="async" />
	: <span class="article-author-avatar" aria-hidden="true">{initials}</span>;
---

<div class={contributorClass}>
	{
		href ? (
			<a class="article-author-image-link" href={href} aria-label={`View ${name} profile`}>
				{avatar}
			</a>
		) : avatar
	}
	<div class="article-contributor-copy">
		<span>{label}</span>
		{href ? <a href={href}>{name}</a> : <strong>{name}</strong>}
		{role && <small>{role}</small>}
	</div>
</div>
