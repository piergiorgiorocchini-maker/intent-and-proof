---
interface RelatedArticle {
	title: string;
	href: string;
	description?: string;
	eyebrow?: string;
	imageSrc?: string;
	imageAlt?: string;
}

interface Props {
	items?: RelatedArticle[];
	title?: string;
	eyebrow?: string;
}

const {
	items = [],
	title = "Continue reading",
	eyebrow = "Related research"
} = Astro.props;
---

{
	items.length > 0 && (
		<section class="editorial-related" aria-labelledby="editorial-related-title">
			<div class="editorial-related__heading">
				{eyebrow && <p>{eyebrow}</p>}
				<h2 id="editorial-related-title">{title}</h2>
			</div>
			<div class="editorial-related__grid">
				{
					items.map((item) => (
						<article class="editorial-related-card">
							{
								item.imageSrc && (
									<a class="editorial-related-card__media" href={item.href} tabindex="-1" aria-hidden="true">
										<img src={item.imageSrc} alt={item.imageAlt || ""} loading="lazy" decoding="async" />
									</a>
								)
							}
							<div class="editorial-related-card__copy">
								{item.eyebrow && <p>{item.eyebrow}</p>}
								<h3><a href={item.href}>{item.title}</a></h3>
								{item.description && <span>{item.description}</span>}
							</div>
						</article>
					))
				}
			</div>
		</section>
	)
}
