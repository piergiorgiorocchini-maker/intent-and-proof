---
import ArticleMeta from "./ArticleMeta.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import ContributorCard from "./ContributorCard.astro";

interface LinkItem {
	href: string;
	label: string;
}

interface Props {
	title: string;
	description?: string;
	eyebrow: string;
	categoryHref: string;
	breadcrumbs?: LinkItem[];
	tags?: LinkItem[];
	publishedDate: string | Date;
	updatedDate?: string | Date;
	readTime?: string;
	author: string;
	authorHref?: string;
	authorRole?: string;
	authorImageSrc?: string;
	authorImageAlt?: string;
	editor?: string;
	editorHref?: string;
	editorImageSrc?: string;
	editorImageAlt?: string;
	heroImageSrc?: string;
	heroImageAlt?: string;
	heroImagePosition?: string;
	heroLayout?: "split" | "background" | "text-only";
	heroTone?: "aurora" | "navy" | "light" | "mint";
	showDescription?: boolean;
	videoUrl?: string;
}

const {
	title,
	description = "",
	eyebrow,
	categoryHref,
	breadcrumbs = [],
	tags = [],
	publishedDate,
	updatedDate,
	readTime = "",
	author,
	authorHref = "",
	authorRole = "",
	authorImageSrc = "",
	authorImageAlt = `${author} portrait`,
	editor = "",
	editorHref = "",
	editorImageSrc = "",
	editorImageAlt = editor ? `${editor} portrait` : "",
	heroImageSrc = "",
	heroImageAlt = "",
	heroImagePosition = "center",
	heroLayout = "split",
	heroTone = "aurora",
	showDescription = true,
	videoUrl = ""
} = Astro.props;

const heroStyle = [
	`--article-hero-image-position: ${heroImagePosition}`,
	heroLayout === "background" && heroImageSrc ? `--article-hero-background-image: url('${heroImageSrc}')` : ""
].filter(Boolean).join("; ");

const showHeroVisual = heroLayout === "split" && Boolean(videoUrl || heroImageSrc);
---

<header class={`article-hero article-hero--${heroLayout} article-hero--${heroTone}`} style={heroStyle}>
	<div class="article-hero-inner">
		<Breadcrumbs items={breadcrumbs} current={title} />

		<div class="article-hero-grid">
			<div class="article-hero-copy">
				<div class="article-hero-taxonomy" aria-label="Article topics">
					<a class="article-eyebrow" href={categoryHref}>{eyebrow}</a>
					{tags.slice(0, 3).map((tag) => <a href={tag.href}>{tag.label}</a>)}
				</div>

				<h1>{title}</h1>
				{showDescription && description && <p class="article-description">{description}</p>}

				<ArticleMeta publishedDate={publishedDate} updatedDate={updatedDate} readTime={readTime} />

				<div class="article-contributors">
					<ContributorCard
						name={author}
						href={authorHref}
						role={authorRole}
						imageSrc={authorImageSrc}
						imageAlt={authorImageAlt}
					/>

					{
						editor && (
							<ContributorCard
								label="Edited by"
								name={editor}
								href={editorHref}
								imageSrc={editorImageSrc}
								imageAlt={editorImageAlt}
								size={48}
								variant="editor"
							/>
						)
					}
				</div>
			</div>

			{
				showHeroVisual && (
					<div class="article-hero-visual">
						{
							videoUrl ? (
								<div class="article-hero-video">
									<iframe
										src={videoUrl}
										title={title}
										allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
										allowfullscreen
									></iframe>
								</div>
							) : (
								<img
									src={heroImageSrc}
									alt={heroImageAlt}
									loading="eager"
									decoding="async"
									style={`aspect-ratio: 3 / 2; object-fit: cover; object-position: ${heroImagePosition}; border-radius: 24px;`}
								/>
							)
						}
					</div>
				)
			}
		</div>
	</div>
</header>

<style is:global>
	.article-hero.article-hero--background .article-hero-grid {
		min-height: 440px;
		padding: 24px 0 36px;
	}

	.article-hero--background h1 {
		font-size: clamp(2.85rem, 4.4vw, 4.65rem);
		line-height: 1;
	}

	.article-hero--background .article-description {
		margin-top: 18px;
		font-size: clamp(1.02rem, 1.25vw, 1.16rem);
	}

	.article-hero--background .article-meta {
		margin-top: 20px;
		padding: 12px 0;
	}

	.article-hero--background .article-contributors {
		margin-top: 16px;
	}

	@media (max-width: 900px) {
		.article-hero.article-hero--background .article-hero-grid {
			min-height: 0;
			padding: 20px 0 30px;
		}

		.article-hero--background h1 {
			font-size: clamp(2.45rem, 9.4vw, 3.55rem);
		}

		.article-right-rail .article-sidebar-cta {
			display: none;
		}

		.article-right-rail {
			gap: 0;
		}

		.article-bottom-cta {
			display: flex;
			padding: 28px;
			align-items: stretch;
			flex-direction: column;
			gap: 20px;
			border: 1px solid rgba(7, 28, 44, 0.1);
			border-radius: 22px;
			background: linear-gradient(135deg, #f2f8f6 0%, #ffffff 100%);
			box-shadow: 0 18px 48px rgba(7, 28, 44, 0.07);
		}

		.article-bottom-cta > div {
			display: grid;
			gap: 8px;
		}

		.article-bottom-cta p,
		.article-bottom-cta h2,
		.article-bottom-cta span {
			margin: 0;
		}

		.article-bottom-cta p {
			color: #08795c;
			font-size: 0.72rem;
			font-weight: 850;
			letter-spacing: 0.12em;
			text-transform: uppercase;
		}

		.article-bottom-cta h2 {
			color: #071c2c;
			font-size: clamp(1.55rem, 7vw, 2.15rem);
			letter-spacing: -0.045em;
			line-height: 1.08;
		}

		.article-bottom-cta span {
			color: #516173;
			line-height: 1.6;
		}

		.article-bottom-cta a {
			display: inline-flex;
			width: 100%;
			min-height: 48px;
			padding: 0 18px;
			align-items: center;
			justify-content: center;
			border-radius: 999px;
			background: #08795c;
			color: #ffffff;
			font-size: 0.86rem;
			font-weight: 820;
			text-align: center;
			text-decoration: none;
			white-space: normal;
		}
	}

	@media (max-width: 640px) {
		.article-hero.article-hero--background .article-hero-grid {
			padding: 14px 0 24px;
		}

		.article-hero--background h1 {
			font-size: clamp(2.2rem, 10.8vw, 3.15rem);
		}

		.article-hero--background .article-description {
			margin-top: 14px;
		}

		.article-hero--background .article-meta {
			margin-top: 16px;
			padding: 10px 0;
		}

		.article-hero--background .article-contributors {
			margin-top: 14px;
		}

		.article-bottom-cta {
			padding: 22px;
		}
	}
</style>
